---
import '@fontsource-variable/heebo';
import '@fontsource-variable/frank-ruhl-libre';
import '@fontsource/shippori-mincho/800.css';
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ogImageFor, structuredData, ldJson } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  noindex?: boolean;
  /** The browser-tab and search-result title, when it should say more than the page's name (e.g. "חוקי השוגי, …"). */
  tabTitle?: string;
}

const { title, description, ogImage = ogImageFor(Astro.url.pathname), noindex = false, tabTitle } = Astro.props;
const fullTitle = title === 'שוגי ישראל' ? 'שוגי ישראל · השחמט היפני, בעברית' : `${tabTitle ?? title} · שוגי ישראל`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogUrl = new URL(ogImage, Astro.site);
const ld = noindex ? [] : structuredData(Astro.url.pathname, title, description);
---
<!doctype html>
<html lang="he" dir="rtl" data-pieces="hebrew">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-192.png" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#ECE4D4" media="(prefers-color-scheme: light)" data-theme-color="light" />
    <meta name="theme-color" content="#221A14" media="(prefers-color-scheme: dark)" data-theme-color="dark" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="he_IL" />
    <meta property="og:site_name" content="שוגי ישראל" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    {ld.map((d) => <script is:inline type="application/ld+json" set:html={ldJson(d)} />)}
    <script is:inline>
      // Apply the saved piece set, colour theme and form of address (lib/gender.ts) before first paint. Storage can be missing (in-app
      // browsers): fall back to the Hebrew pieces and to the system's light/dark setting.
      (function () {
        var root = document.documentElement;
        var pref = '';
        try {
          var pieces = localStorage.getItem('pieces');
          if (pieces === 'letters' || pieces === 'kanji') root.setAttribute('data-pieces', pieces);
          if (localStorage.getItem('gender') === 'f') root.setAttribute('data-gender', 'f');
          pref = localStorage.getItem('theme') || '';
        } catch (e) {}
        if (pref !== 'light' && pref !== 'dark') pref = '';
        var dark = pref ? pref === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
        root.setAttribute('data-theme', dark ? 'dark' : 'light');
        root.setAttribute('data-theme-pref', pref || 'auto');
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">⟦דלג|דלגי⟧ לתוכן</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Analytics />
    <script>
      import '../scripts/gender';
    </script>
    <script>
      // Sounds on every page (src/learn/sound.ts): unlocks audio on the first tap (phones) and ticks for buttons and menus.
      import '../learn/sound';
    </script>
    <script>
      // Arrived from one of our ads? Keep which one for this tab, so a new account can record it.
      import { rememberAdSource } from '../lib/ad-source';
      rememberAdSource();
    </script>
    <script>
      // The (?) explanations (lib/info-tips.ts): one set of listeners for every tip on the page.
      import '../scripts/info-tips';
    </script>
    <script>
      // One listener for every piece-set switch on the page (Hebrew / letters / kanji).
      import { pieceSetOf } from '../lib/piece-set';
      const root = document.documentElement;
      const sync = () => {
        const set = pieceSetOf(root.getAttribute('data-pieces'));
        document.querySelectorAll<HTMLButtonElement>('[data-pieces-set]').forEach((b) => {
          b.setAttribute('aria-pressed', String(b.dataset.piecesSet === set));
        });
      };
      document.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-pieces-set]');
        if (!btn) return;
        const set = pieceSetOf(btn.dataset.piecesSet);
        root.setAttribute('data-pieces', set);
        try { localStorage.setItem('pieces', set); } catch {}
        sync();
        document.dispatchEvent(new CustomEvent('pieces-changed', { detail: set }));
      });
      sync();
    </script>
    <script>
      // Light / dark: the header button and the settings switches all land here. "auto" follows the system.
      const root = document.documentElement;
      const scheme = window.matchMedia('(prefers-color-scheme: dark)');
      const COLORS = { light: '#ECE4D4', dark: '#221A14' };
      const applyTheme = (pref: string) => {
        const dark = pref === 'auto' ? scheme.matches : pref === 'dark';
        root.setAttribute('data-theme', dark ? 'dark' : 'light');
        root.setAttribute('data-theme-pref', pref);
        // An explicit choice overrides the media-split theme-color tags; "auto" puts them back.
        document.querySelectorAll<HTMLMetaElement>('meta[data-theme-color]').forEach((m) => {
          const own = m.dataset.themeColor as 'light' | 'dark';
          m.content = pref === 'auto' ? COLORS[own] : COLORS[dark ? 'dark' : 'light'];
        });
        document.querySelectorAll<HTMLButtonElement>('[data-theme-set]').forEach((b) => {
          b.setAttribute('aria-pressed', String(b.dataset.themeSet === pref));
        });
        document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((b) => {
          b.setAttribute('aria-label', dark ? 'מעבר למצב בהיר' : 'מעבר למצב כהה');
          b.setAttribute('aria-pressed', String(dark));
        });
      };
      const savePref = (pref: string) => {
        try { if (pref === 'auto') localStorage.removeItem('theme'); else localStorage.setItem('theme', pref); } catch {}
        applyTheme(pref);
      };
      document.addEventListener('click', (e) => {
        const t = e.target as HTMLElement;
        const set = t.closest<HTMLButtonElement>('[data-theme-set]');
        if (set) return savePref(set.dataset.themeSet === 'light' || set.dataset.themeSet === 'dark' ? set.dataset.themeSet : 'auto');
        if (t.closest('[data-theme-toggle]')) savePref(root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark');
      });
      scheme.addEventListener('change', () => {
        if (root.getAttribute('data-theme-pref') === 'auto') applyTheme('auto');
      });
      // Keep two open tabs in step.
      window.addEventListener('storage', (e) => {
        if (e.key === 'theme') applyTheme(e.newValue === 'light' || e.newValue === 'dark' ? e.newValue : 'auto');
      });
      applyTheme(root.getAttribute('data-theme-pref') || 'auto');
    </script>
    <script>
      // Signed-in visitors: keep lesson progress in step with the account. Others never load the Supabase client.
      import { accountsEnabled, hasStoredSession } from '../lib/account-config';
      if (accountsEnabled && hasStoredSession()) {
        document.documentElement.setAttribute('data-signed-in', '');
        if (location.pathname !== '/account/') import('../lib/account').then((m) => m.startSync());
        import('../lib/xp-toast').then((m) => m.startXpNotes()); // points and ranks
        import('../lib/inbox-ui').then((m) => m.startInbox()); // the bell in the header
      } else if (accountsEnabled) {
        import('../lib/xp-toast').then((m) => m.startXpNotes(true)); // a preview of the points an account would keep
      }
    </script>
  </body>
</html>
