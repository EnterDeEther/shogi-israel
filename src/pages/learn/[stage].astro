---
import Base from '../../layouts/Base.astro';
import LearnStage from '../../components/LearnStage.astro';
import { stages } from '../../learn/categories';
import { stageSlug } from '../../learn/urls';

export function getStaticPaths() {
  return stages.map((s) => ({ params: { stage: stageSlug(s.key) }, props: { title: s.title, subtitle: s.subtitle } }));
}
const { stage } = Astro.params;
const { title, subtitle } = Astro.props;
---
<Base title={`${title} · שיעור אינטראקטיבי`} description={`תרגול אינטראקטיבי בשוגי: ${title}. ${subtitle}`.replace(/\*\*/g, '')}>
  <div class="wrap wrap--learn">
    <LearnStage stage={stage} />
  </div>
</Base>
