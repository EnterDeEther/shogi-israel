---
// /learn/guide/: what an opening, a castle and a strategy are, and why. Linked both ways with the lessons:
// each lesson category on /learn/ and each lesson's start screen point here, and this page lists the lessons.
import Page from '../../layouts/Page.astro';
import Board from '../../components/Board.astro';
import { categories } from '../../learn/categories';
import { stageUrl } from '../../learn/urls';

const START = 'lnsgkgsnl/1r5b1/ppppppppp/9/9/9/PPPPPPPPP/1B5R1/LNSGKGSNL b - 1';
const MINO = 'lnsgkgsnl/1r5b1/ppppppppp/9/9/8P/PPPPPPPP1/1B1RG1SK1/LNS2G1NL b - 15';
const YAGURA = 'lnsgkgsnl/1r5b1/ppppppppp/9/9/2PPP4/PPSG1PPPP/1KGB3R1/LN4SNL b - 27';

const cat = (key: string) => categories.find((c) => c.key === key)!;
const lessons = (key: string) => cat(key).stages.map((s) => ({ href: stageUrl(s.key), title: s.title, subtitle: s.subtitle.replace(/\*\*/g, '') }));
const stage = (key: string) => cat('openings').stages.concat(cat('castles').stages, cat('strategy').stages).find((s) => s.key === key)!;
const link = (key: string) => ({ href: stageUrl(key), title: stage(key).title });
---
<Page
  title="פתיחות, מבצרים ואסטרטגיה: מה זה ולמה"
  eyebrow="למדו לשחק"
  description="איך נראה משחק שוגי מההתחלה ועד ההתקפה: מהי פתיחה, מהו מבצר, ומהי אסטרטגיה, ולמה כל אחד מהם נחוץ. עם קישורים לשיעורים המתאימים."
>
  <p class="lead">אחרי שאתם יודעים איך הכלים זזים, כל משחק שוגי מתחלק לשלושה חלקים: <strong>פתיחה</strong> מסדרת את הכלים, <strong>מבצר</strong> מגן על המלך, ו<strong>אסטרטגיה</strong> היא התוכנית שבה תוקפים. הדף הזה מסביר מה כל חלק עושה ולמה, והשיעורים האינטראקטיביים מראים אותו מהלך אחרי מהלך.</p>

  <nav class="toc small" aria-label="בדף הזה">
    <a href="#opening">פתיחה</a>
    <a href="#castle">מבצר</a>
    <a href="#strategy">אסטרטגיה</a>
    <a href="#order">באיזה סדר ללמוד</a>
  </nav>

  <h2 id="opening">מהי פתיחה</h2>
  <p><strong>פתיחה</strong> היא עשרים המהלכים בערך הראשונים. הכלים החזקים, הצריח והרץ, מתחילים סגורים מאחורי הרגלים שלהם, ובלי פתיחה הם לא משחקים. לכן המהלך הראשון כמעט תמיד פותח להם דרך: רגלי ב־76 פותח את האלכסון של הרץ, ורגלי ב־26 מתחיל את הטור של הצריח.</p>
  <Board sfen={START} caption="מערך הפתיחה. הצריח והרץ סגורים מאחורי הרגלים." />
  <p>פתיחה טובה עושה ארבעה דברים, ואת כולם כדאי לשאול לפני כל מהלך:</p>
  <ol>
    <li><strong>פותחת קווים לכלים הגדולים.</strong> כל רגלי שזז הוא החלטה: באיזה כלי רוצים להשתמש קודם.</li>
    <li><strong>בוחרת אגף להתקפה ואגף למגורים.</strong> הצריח הוא התוקף העיקרי, והמלך גר בצד השני. כלל אחד שווה לזכור: <em>המלך רחוק מהצריח</em>. אם שניהם באותו צד, רץ של היריב יכול להצניח ולעשות <strong>מזלג מלך וצריח</strong>, ולקחת את הצריח בחינם.</li>
    <li><strong>מכינה את המבצר.</strong> הפתיחה ובניית המבצר קורות יחד, ולכן כל פתיחה באה עם מבצר שמתאים לה.</li>
    <li><strong>מכינה חילוף רגלים.</strong> התקפה מתחילה בדחיפת רגלי שמציע חילוף. החילוף נותן לכם רגלי ביד, והרגלי ביד הוא הדלק להתקפה הבאה.</li>
  </ol>

  <h3>שתי משפחות</h3>
  <p>כמעט כל הפתיחות שייכות לאחת משתי משפחות, לפי המקום של הצריח:</p>
  <ul>
    <li><strong>צריח קבוע</strong> נשאר בטור 2 ותוקף ישר קדימה. המלך בורח שמאלה. זו הדרך הישירה.</li>
    <li><strong>צריח נודד</strong> עובר שמאלה, למשל לטור 6. המלך עובר ימינה למבצר מינו, מחכים שהיריב יתקוף, ואז מחליפים כלים בצד שלו ותוקפים בחזרה. היא מתאימה למי שאוהב להגיב להתקפה של היריב.</li>
  </ul>
  <p>אין משפחה טובה יותר. למדו אחת מכל סוג ותבינו מה השני מנסה לעשות לכם.</p>
  <p class="lessons-head">השיעורים בנושא:</p>
  <ul class="lessons">
    {lessons('openings').map((l) => <li><a href={l.href}>{l.title}</a> <span class="muted">{l.subtitle}</span></li>)}
  </ul>

  <h2 id="castle">מהו מבצר</h2>
  <p>בשחמט יש הצרחה: מהלך אחד והמלך מוגן. בשוגי אין, וקורה שם משהו שמחייב הגנה חזקה יותר: כלי שנלכד עובר ליריב, ואפשר להצניח אותו ליד המלך שלכם בכל רגע. לכן בונים <strong>מבצר</strong> בכמה מהלכים: המלך זז הצידה, ושלושה גנרלים, זהב, כסף וזהב, מתיישבים סביבו.</p>
  <Board sfen={MINO} highlight="28,38,49,58" caption="מבצר מינו: המלך ב־28, הכסף ב־38 והזהבים ב־49 וב־58." />
  <p>שימו לב למה שהופך אותו לחזק. כל גנרל מגן על שכנו באלכסון, ולכן קשה ללכוד בו כלי בלי שהיריב ישלם על זה. המלך עומד מחוץ לטור של הצריח ומחוץ לאלכסון הראשי של הרץ, ולכן קשה לתקוף אותו ממרחק.</p>
  <h3>שלושה כללים לכל מבצר</h3>
  <ul>
    <li><strong>מגינים לפני שתוקפים, אבל לא בונים יותר מדי.</strong> ההתקפה צריכה בערך ארבעה כלים: צריח, רץ, כסף ופרש. המשחק הוא מירוץ בין שני הצדדים: מי שמסיים את המבצר ואת ההתקפה מהלך אחד לפני השני, מנצח.</li>
    <li><strong>הגנרלים זזים באלכסון.</strong> זהב שהתקדם ישר משאיר חורים מאחוריו, והוא לא יכול לחזור באלכסון אחורה. כסף יכול, ולכן הכסף הוא הכלי לשלוח קדימה. הזהב נשאר להגן.</li>
    <li><strong>לכל מבצר יש צד חלש.</strong> מינו חזק מהצדדים וחלש מלמעלה. יגורה חזק מקדימה וחלש מהקצה. הפתיחות נבחרות גם כדי להכות בצד החלש של היריב.</li>
  </ul>
  <Board sfen={YAGURA} highlight="88,77,78,67" caption="יגורה: חומה של גנרלים לפני המלך ב־88. קשה לפרוץ אותה מקדימה." />
  <p>איזה מבצר מתאים לאיזו פתיחה:</p>
  <table class="pairs">
    <thead><tr><th>פתיחה</th><th>מבצר</th><th>למה</th></tr></thead>
    <tbody>
      <tr><td>צריח נודד: טור 6, טור 7, אישידה, צריח מרכזי</td><td>מינו, אחר כך מינו גבוה וכתר הכסף</td><td>מהיר, וחזק מול התקפות מהצד, ומשם באות ההתקפות של צריח קבוע</td></tr>
      <tr><td>צריח נודד הדדי</td><td>שני הזהבים</td><td>ההתקפה באה מלמעלה</td></tr>
      <tr><td>צריח קבוע נגד צריח נודד, התקפה מהירה</td><td>סירה</td><td>מהירות</td></tr>
      <tr><td>צריח קבוע נגד צריח נודד, משחק איטי</td><td>דוב במאורה</td><td>בטיחות, כי המשחק יהיה ארוך</td></tr>
      <tr><td>יגורה, וצריח קבוע מול צריח קבוע</td><td>יגורה</td><td>שני הצדדים תוקפים מקדימה</td></tr>
    </tbody>
  </table>
  <p class="lessons-head">השיעורים בנושא:</p>
  <ul class="lessons">
    {lessons('castles').map((l) => <li><a href={l.href}>{l.title}</a> <span class="muted">{l.subtitle}</span></li>)}
  </ul>

  <h2 id="strategy">מהי אסטרטגיה</h2>
  <p>המבצר מוכן. מה עושים עכשיו? <strong>אסטרטגיה</strong> היא התוכנית להתקפה: איפה פורצים, עם אילו כלים, ובאיזה סדר. בשוגי רוב התוכניות בנויות סביב הכסף, הגנרל שיכול גם לתקוף וגם לסגת.</p>
  <h3>התקפה מהירה או משחק איטי</h3>
  <p>לפני שבוחרים תוכנית שואלים שאלה אחת: מי מוכן ראשון? אם המבצר של היריב עוד לא גמור, כדאי <strong>התקפה מהירה</strong> לפני שיספיק לסיים. אם הוא כבר מוגן, שום פריצה מהירה לא תעבוד, ועדיף <strong>משחק איטי</strong>: בונים מבצר חזק יותר, ושומרים על יוזמה עד שנפתחת הזדמנות.</p>
  <h3>רעיונות שחוזרים בכל תוכנית</h3>
  <ul>
    <li><strong>שני תוקפים מול מגן אחד.</strong> ספרו את התוקפים והמגינים על משבצת הפריצה לפני שדוחפים. זה כל הרעיון של הכסף המטפס: הכסף והצריח יחד מול מגן יחיד.</li>
    <li><strong>הכסף יוצא, הזהב נשאר.</strong> הכסף נסוג באלכסון כשצריך. הזהב שיצא לא חוזר.</li>
    <li><strong>התקפת קצה.</strong> רומח וצריח בטור הקצה, אחד מאחורי השני, ורגלי שפותח את הטור. בנוסף, רגלי הקצה ב־16 נותן למלך משבצת בריחה.</li>
    <li><strong>רגלי תלוי.</strong> מצניחים רגלי ממש לפני אזור ההכתרה, כך שבמהלך הבא הוא נכנס ומוכתר. קשה מאוד לעצור אותו.</li>
    <li><strong>הפרש הולך רק קדימה.</strong> קפצו רק כשהמשבצת שאליה נוחתים מוגנת, או כשהקפיצה זוכה בחומר.</li>
    <li><strong>יוזמה שווה לפעמים יותר מחומר.</strong> רגלי אחד יותר לא שווה אם בגללו היריב מקבל את הזמן לבנות.</li>
  </ul>
  <p class="lessons-head">השיעורים בנושא:</p>
  <ul class="lessons">
    {lessons('strategy').map((l) => <li><a href={l.href}>{l.title}</a> <span class="muted">{l.subtitle}</span></li>)}
  </ul>

  <h2 id="order">באיזה סדר ללמוד</h2>
  <ol>
    <li>קודם <a href={link('staticRook').href}>{link('staticRook').title}</a> ו<a href={link('rangingRook').href}>{link('rangingRook').title}</a>: שתי המשפחות, בקצרה.</li>
    <li>אחת מכל משפחה: <a href={link('primitiveClimbingSilver').href}>{link('primitiveClimbingSilver').title}</a> לצריח קבוע, ו<a href={link('fourthFileRook').href}>{link('fourthFileRook').title}</a> עם מבצר מינו לצריח נודד.</li>
    <li>אחר כך <a href={link('centralRook').href}>{link('centralRook').title}</a> ו<a href={link('yagura').href}>{link('yagura').title}</a>, ו<a href={stageUrl('rangingCastles')}>מבצרים לצריח נודד</a>.</li>
    <li>ולסיום <a href={link('whatIf').href}>מה אם היריב טועה?</a>, שבו מנצלים טעויות נפוצות של היריב.</li>
  </ol>
  <p><a class="btn" href="/learn/#cat-openings">לשיעורים האינטראקטיביים</a></p>
</Page>

