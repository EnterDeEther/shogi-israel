---
import Base from '../layouts/Base.astro';
import Board from '../components/Board.astro';
import InfoTip from '../components/InfoTip.astro';
import { CHESS_CURRICULUM, CHESS_LEVEL_INFO, CURRICULUM, KIND_LABEL, LEVELS, LEVEL_INFO, stepHref } from '../lib/curriculum';
import { LEVEL_COUNTS as levelCounts } from '../lib/level-counts';
import { RANKS, rankFor, stepXp, XP } from '../lib/xp';
import { emptyProgress } from '../lib/progress-sync';
import { accountsEnabled } from '../lib/account-config';
import { pageExists } from '../lib/live';
import { WHATSAPP_URL } from '../lib/nav';

const empty = emptyProgress();
const PATHS = [
  { route: 'main', units: CURRICULUM, info: LEVEL_INFO },
  { route: 'chess', units: CHESS_CURRICULUM, info: CHESS_LEVEL_INFO },
] as const;
const levelEnd = (units: typeof CURRICULUM, route: 'main' | 'chess') => {
  let sum = 0;
  return LEVELS.map((l) => {
    for (const u of units.filter((x) => x.level === l)) {
      sum += u.steps.filter((s) => !s.optional?.includes(route) && !s.known?.includes(route) && (!s.only || s.only.includes(route)))
        .reduce((t, s) => t + stepXp(s, levelCounts), XP.unit);
    }
    return rankFor(sum).rank.name;
  });
};
const accountsOn = accountsEnabled && pageExists('/account/');

const CHECK = [
  {
    sfen: '4k4/9/9/9/9/9/4P4/9/4K4 b P 1', highlight: '54',
    q: 'יש לך רגלי ביד. מותר להצניח אותו על המשבצת המסומנת?',
    options: [['yes', 'כן'], ['no', 'לא']], answer: 'no',
    why: 'אסור: כבר יש לך רגלי לא מוכתר באותו טור. שני רגלים בטור אחד הם מהלך לא חוקי.',
  },
  {
    sfen: '4k4/9/4P4/9/9/9/9/9/4K4 b G 1', highlight: '',
    q: 'יש לך גנרל זהב ביד. לאן ⟦תצניח|תצניחי⟧ אותו כדי לתת מט?',
    options: [['5b', 'ישר מול המלך, צמוד אליו'], ['4b', 'באלכסון, ליד המלך'], ['4a', 'בשורה של המלך, משבצת לצדו']], answer: '5b',
    why: 'ישר מול המלך: הרגלי שומר על הגנרל, והגנרל סוגר את כל המשבצות שהמלך יכול לברוח אליהן.',
  },
  {
    sfen: 'lnsgkgsnl/5r1b1/ppppp2pp/5pp2/7P1/2P6/PP1PPPP1P/1B5R1/LNSGKGSNL b - 7', highlight: '',
    q: 'אחרי כמה מהלכי פתיחה: מי משחק כאן צריח נודד?',
    options: [['gote', 'המשיב (למעלה)'], ['sente', 'הפותח (למטה)'], ['both', 'שניהם']], answer: 'gote',
    why: 'הצריח של המשיב עבר מהצד הימני שלו לטור 4. הצריח של הפותח נשאר במקומו: צריח קבוע.',
  },
];
---
<Base
  title="מסלול לימוד אישי: מאיפה מתחילים"
  description="מסלול לימוד שוגי בעברית ובחינם, בשלוש רמות: מתחילים, בינוניים ומתקדמים. כל כלי וכל כלל מוסבר לפני שמשתמשים בו, ויש גם מסלול לשחקני שחמט."
>
  <div class="wrap page" data-course>
    <p class="eyebrow">⟦למד|למדי⟧ לשחק</p>
    <h1>מסלול לימוד אישי<span data-route-only="chess" hidden> לשחקני שחמט</span></h1>
    <p class="lead" data-route-only="main">כל מה שיש באתר ללמוד, בסדר אחד ובשלוש רמות: מתחילים, בינוניים ומתקדמים. כל כלי וכל כלל מוסבר לפני שמשתמשים בו, כך שאפשר להתחיל בלי לדעת כלום, גם לא שחמט.</p>
    <p class="lead" data-route-only="chess" hidden>מסלול נפרד, רק עם מה שחדש לשחקן שחמט: חמשת הכלים החדשים, הכלל שאין בשחמט, ומבצרים במקום הצרחה. מה שכבר מוכר לך הוא חזרה מהירה, וכל הסבר משווה לשחמט. <a href="/course/?route=main" data-route-switch="main">למסלול הרגיל, בלי השוואות לשחמט</a></p>
    <p class="small muted" data-route-only="main"><a href="/course/?route=chess" data-route-switch="chess">⟦משחק|משחקת⟧ שחמט? יש מסלול נפרד בשבילך</a></p>
    <p class="phases-note small muted">בכל שיעור כתוב לאיזה משלושת שלבי המשחק הוא שייך: פתיחה, אמצע המשחק או סוף המשחק.<InfoTip id="phases" /></p>

    <section class="gate card" data-gate aria-labelledby="gate-h">
      <h2 id="gate-h">מסלול אישי, נקודות ודרגות</h2>
      {accountsOn ? (
        <>
          <p>עם חשבון (בחינם) המסלול נהיה שלך: ⟦אתה|את⟧ עונה על שתי שאלות ⟦ומקבל|ומקבלת⟧ נקודת התחלה, רואה בכל רגע את הצעד הבא, ⟦וצובר|וצוברת⟧ נקודות שמעלות אותך בדרגה, מ־15 קיו ועד דאן (<a href="/ranks/#site">דרגות של לימוד, לא דרגה רשמית</a>). ההתקדמות נשמרת בכל מכשיר.</p>
          <p class="small muted">מה שכבר עשית בדפדפן הזה נכנס לחשבון ונספר.</p>
          <p class="gate-cta"><a class="btn" href="/account/?mode=signup"><span>⟦פתח|פתחי⟧ חשבון בחינם</span></a> <a href="/account/?mode=signin">כבר יש לך חשבון? כניסה</a></p>
        </>
      ) : (
        <p>המסלול האישי ייפתח יחד עם החשבונות באתר. בינתיים אפשר ללמוד לפי הסדר שכאן.</p>
      )}
      <p class="small muted">כל השיעורים פתוחים גם בלי חשבון. הנה המסלול המלא:</p>
    </section>

    <section class="placement card" data-placement hidden aria-labelledby="place-h">
      <h2 id="place-h">מאיפה מתחילים?</h2>
      <div data-place-step="questions">
        <fieldset class="q">
          <legend>כמה שוגי ⟦שיחקת|שיחקת⟧?</legend>
          <div class="opts" role="group">
            <button type="button" class="opt" data-exp="none" aria-pressed="false"><strong>אף פעם</strong><span class="small muted">או רק ראיתי פעם</span></button>
            <button type="button" class="opt" data-exp="rules" aria-pressed="false"><strong>אני ⟦מכיר|מכירה⟧ את החוקים</strong><span class="small muted">יודע איך הכלים זזים</span></button>
            <button type="button" class="opt" data-exp="plays" aria-pressed="false"><strong>אני ⟦משחק|משחקת⟧</strong><span class="small muted">שיחקתי לא מעט משחקים</span></button>
          </div>
        </fieldset>
        <fieldset class="q">
          <legend>⟦משחק|משחקת⟧ שחמט?</legend>
          <div class="opts two" role="group">
            <button type="button" class="opt" data-chess="yes" aria-pressed="false"><strong>כן</strong><span class="small muted">מסלול נפרד, רק עם מה שחדש לך</span></button>
            <button type="button" class="opt" data-chess="no" aria-pressed="false"><strong>לא</strong><span class="small muted">הכול יוסבר מההתחלה</span></button>
          </div>
        </fieldset>
        <div class="place-actions" data-place-actions hidden>
          <button type="button" class="btn" data-place-go><span>זהו, ⟦הראה|הראי⟧ לי מאיפה להתחיל</span></button>
          <button type="button" class="btn btn-ghost" data-check-start hidden><span>בדיקה קצרה על הלוח (רשות, שתי דקות)</span></button>
        </div>
        <p class="small muted"><button type="button" class="link" data-manual>⟦אבחר|אבחר⟧ רמה בעצמי</button> · אפשר לשנות את זה בכל רגע, וכל השיעורים נשארים פתוחים.</p>
      </div>

      <div data-place-step="check" hidden>
        <p class="small muted" data-check-count></p>
        {CHECK.map((c, i) => (
          <div class="check" data-check={i} data-answer={c.answer} hidden>
            <Board sfen={c.sfen} highlight={c.highlight} toggle={false} size="compact" />
            <p class="check-q"><strong>{c.q}</strong></p>
            <div class="opts" role="group">
              {c.options.map(([v, label]) => <button type="button" class="opt" data-check-answer={v}><strong>{label}</strong></button>)}
            </div>
            <p class="check-why small" data-check-why hidden>{c.why}</p>
            <button type="button" class="btn" data-check-next hidden><span>{i < CHECK.length - 1 ? 'לשאלה הבאה' : 'לתוצאה'}</span></button>
          </div>
        ))}
        <p class="small"><button type="button" class="link" data-check-skip>⟦דלג|דלגי⟧ על הבדיקה</button></p>
      </div>

      <div data-place-step="manual" hidden>
        <p>⟦בחר|בחרי⟧ רמה. אפשר לשנות בכל רגע.</p>
        <div class="opts">
          {LEVELS.map((l) => (
            <button type="button" class="opt" data-pick={l}>
              <strong>{LEVEL_INFO[l].title}</strong>
              <span class="small">{LEVEL_INFO[l].goal}</span>
              <span class="small muted">{LEVEL_INFO[l].why}</span>
            </button>
          ))}
        </div>
        <label class="chess-box small"><input type="checkbox" data-pick-chess /> ⟦אני משחק|אני משחקת⟧ שחמט: המסלול לשחקני שחמט</label>
        <p class="small"><button type="button" class="link" data-back-questions>חזרה לשאלות</button></p>
      </div>
    </section>

    <section class="chosen" data-chosen hidden>
      <p><span class="muted">נקודת ההתחלה:</span> <strong data-chosen-label></strong> · <button type="button" class="link" data-change>שינוי</button></p>
      <p class="small muted" data-chosen-why></p>
    </section>

    <section class="next card" data-next hidden aria-labelledby="next-h">
      <p class="eyebrow" id="next-h">הצעד הבא</p>
      <p class="next-where small muted" data-next-where></p>
      <h2 data-next-title></h2>
      <p data-next-why></p>
      <a class="btn" data-next-link href="/learn/introduction/"><span>⟦התחל|התחילי⟧</span></a>
    </section>

    <section class="rank card" data-rank hidden aria-labelledby="rank-h">
      <span class="rank-kanji" lang="ja" aria-hidden="true" data-rank-kanji></span>
      <div class="rank-body">
        <p class="small muted" id="rank-h">הדרגה שלך</p>
        <div class="rank-line"><p class="rank-name" data-rank-name></p><InfoTip id="rank" /></div>
        <div class="bar" aria-hidden="true"><span data-rank-bar></span></div>
        <p class="small muted" data-rank-text></p>
        <p class="small"><a href="/ranks/#site">מה הדרגה הזאת אומרת, ומה לא?</a></p>
        <p class="rank-share" data-rank-share></p>
        <details class="rank-how">
          <summary class="small">איך צוברים נקודות?</summary>
          <ul class="small">
            <li>כוכב בתרגול על הלוח: {XP.star} נקודות (עד 3 כוכבים בכל תרגיל)</li>
            <li>שיעור בחוקים הבסיסיים: {XP.rules}</li>
            <li>בעיית מט: {XP.tsume[1]} (מט ב־1), {XP.tsume[3]} (ב־3), {XP.tsume[5]} (ב־5), {XP.tsume[7]} (ב־7)</li>
            <li>משחק ראשון שסיימת בכל רמה נגד המחשב: {XP.played}</li>
            <li>ניצחון ראשון בכל רמה: {XP.won} כפול מספר הרמה</li>
            <li>קריאת פרק במדריך מתוך המסלול: {XP.read}</li>
            <li>בונוס על כל צעד שהשלמת במסלול: {XP.step}</li>
            <li>בונוס על חלק שהשלמת כולו (למשל "כלי השוגי"): {XP.unit}</li>
          </ul>
          <p class="small muted">כל דבר נספר פעם אחת: חזרה על תרגיל או בעיה שכבר פתרת לא מוסיפה נקודות, ושיפור מכוכב אחד לשלושה מוסיף רק את ההפרש. צעד שסומן "כבר מוכר" לא נותן נקודות עד ⟦שתעשה|שתעשי⟧ אותו. הדרגות נקראות על שם דרגות השוגי, קיו ודאן, אבל מודדות התקדמות בלימוד באתר, לא כוח משחק (<a href="/ranks/">איך זה עובד בעולם</a>). יש {RANKS.length} דרגות, מ־{RANKS[0].name} ועד {RANKS[RANKS.length - 1].name}.</p>
        </details>
      </div>
    </section>

    <section class="done-all card" data-done-all hidden>
      <h2>סיימת את המסלול!</h2>
      <p>עברת את כל שלוש הרמות. מכאן ⟦המשך|המשיכי⟧ לשחק: נגד המחשב ברמות גבוהות יותר, עם ישראלים בקהילה, ומול שחקנים מכל העולם.</p>
      <p><a href="/play/?level=5">נגד המחשב, מרמה 5 והלאה</a> · <a href="/tsume/7/">בעיות מט ב־7 מהלכים</a> · <a href={WHATSAPP_URL} rel="noopener">קהילת הוואטסאפ</a> · <a href="/lishogi/">יריבים מכל העולם בליש׳וגי</a></p>
    </section>

    <div class="overall" data-overall hidden>
      <div class="bar" aria-hidden="true"><span data-overall-bar></span></div>
      <p class="small muted" data-overall-text></p>
    </div>

    {accountsOn && <p class="small muted save-note" data-signed-in-only>ההתקדמות נשמרת בחשבון שלך, בכל מכשיר.</p>}

    <nav class="level-nav small" aria-label="שלוש הרמות">
      {LEVELS.map((l, i) => <a href={`#${l}`}>{i + 1}. {LEVEL_INFO[l].title}</a>)}
    </nav>

    {PATHS.map(({ route, units, info }) => (
      <div class="path" data-path={route} hidden={route !== 'main'}>
        {LEVELS.map((l, i) => (
          <section class="level" id={route === 'main' ? l : `${route}-${l}`} data-level={l} aria-labelledby={`${route}-${l}-h`}>
            <header class="level-head">
              <p class="level-tag">רמה {i + 1} מתוך {LEVELS.length} · בסופה בערך {levelEnd(units, route)[i]} בדרגות הלימוד<InfoTip id="rank" /></p>
              <h2 id={`${route}-${l}-h`}>{info[l].title}</h2>
              <p class="level-goal"><strong>המטרה: {info[l].goal}.</strong> {info[l].why}</p>
              <p class="level-known small" data-level-known hidden>כבר מוכר לך, לפי נקודת ההתחלה. הכול נשאר פתוח לחזרה, וצעד ⟦שתעשה|שתעשי⟧ ייספר.</p>
            </header>
            {units.filter((u) => u.level === l).map((u) => (
              <section class="unit" id={u.key} data-unit={u.key} aria-labelledby={`${u.key}-h`}>
                <header class="unit-head">
                  <h3 id={`${u.key}-h`}>{u.title}</h3>
                  <p class="unit-goal">{u.why}</p>
                  <div class="unit-progress" data-unit-progress hidden>
                    <div class="bar" aria-hidden="true"><span></span></div>
                    <span class="small muted"></span>
                  </div>
                </header>
                <ol class="steps">
                  {u.steps.map((s) => (
                    <li class="step" data-step={s.id} data-kind={s.kind} hidden={!!s.only && !s.only.includes(route)}>
                      <span class="mark" aria-hidden="true"></span>
                      <div class="step-body">
                        <a class="step-title" href={stepHref(s, empty, levelCounts)} data-step-link>{s.title}</a>
                        <p class="step-meta small muted">
                          <span>{KIND_LABEL[s.kind]}</span> · <span>{s.minutes} דק׳</span>
                          <span class="opt-tag" data-opt-tag hidden={!s.optional?.includes(route) || !!s.known?.includes(route)}> · רשות</span>
                          <span class="opt-tag" data-known-tag hidden={!s.known?.includes(route)}> · כבר מוכר</span>
                          <span class="count" data-count></span>
                          <span class="xp" data-xp hidden> · עד +{stepXp(s, levelCounts)} נק׳</span>
                          <span class="sr-only" data-state-sr></span>
                        </p>
                        <p class="step-why">{s.why}</p>
                      </div>
                      <button type="button" class="step-skip small" data-skip hidden>כבר ⟦יודע|יודעת⟧</button>
                    </li>
                  ))}
                </ol>
              </section>
            ))}
          </section>
        ))}
      </div>
    ))}

    <p class="small muted foot">עוד באתר: <a href="/learn/">מפת השיעורים האינטראקטיביים</a> · <a href="/learn/guide/">פתיחות, מבצרים ואסטרטגיה</a> · <a href="/rules/">חוקים בסיסיים</a> · <a href="/tsume/">בעיות מט</a></p>
  </div>
</Base>

<script>
  import { ALL_STEPS, KIND_LABEL, LEVELS, LEVEL_INFO, ROUTE_INFO, curriculumFor, hasAnyProgress, isKnown, isOptional, isSkipped, legacyOf, nextStep, pathProgress, placeFrom, placeLabel, stepCount, stepHref, stepState, stepsFor, unitProgress, unitsOf, whereLabel, type Experience } from '../lib/curriculum';
  import { markSeen, readLocal, updateCourse } from '../lib/progress-local';
  import type { CourseLevel, Route, SyncedProgress } from '../lib/progress-sync';
  import { accountsEnabled, hasStoredSession } from '../lib/account-config';
  import { LEVEL_COUNTS as levelCounts } from '../lib/level-counts';
  import { rankFor, xpBreakdown } from '../lib/xp';
  import { shareButton } from '../lib/share-card';

  const root = document.querySelector<HTMLElement>('[data-course]')!;
  const signedIn = accountsEnabled && hasStoredSession();
  const $ = <T extends HTMLElement>(sel: string, scope: ParentNode = root) => scope.querySelector<T>(sel)!;
  const $$ = <T extends HTMLElement>(sel: string, scope: ParentNode = root) => [...scope.querySelectorAll<T>(sel)];
  let changing = false;

  const STATE_SR = { done: 'הושלם', skipped: 'סומן כמוכר', todo: '' } as const;

  const asked = ((r) => (r === 'chess' || r === 'main' ? r : null))(new URLSearchParams(location.search).get('route')) as Route | null;
  const deviceRoute = ((): Route | null => {
    try { const r = localStorage.getItem('learnRoute'); return r === 'chess' || r === 'main' ? r : null; } catch { return null; }
  })();
  const pathEl = () => $(`[data-path="${root.dataset.route ?? 'main'}"]`);
  function showPath(route: Route) {
    root.dataset.route = route;
    $$('[data-path]').forEach((el) => { el.hidden = el.dataset.path !== route; });
    $$('[data-route-only]').forEach((el) => { el.hidden = el.dataset.routeOnly !== route; });
    $$('[data-path] [data-level]').forEach((el) => {
      const path = el.closest<HTMLElement>('[data-path]')!.dataset.path;
      el.id = path === route ? el.dataset.level! : `${path}-${el.dataset.level}`;
    });
  }
  function scrollToHash() {
    const el = location.hash.length > 1 ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null;
    if (el && !el.closest('[hidden]')) el.scrollIntoView();
  }

  let exp: Experience | null = null;
  let chess: boolean | null = asked ? asked === 'chess' : deviceRoute === 'chess' ? true : null;
  let score = 0;

  function showStep(name: 'questions' | 'check' | 'manual') {
    $$('[data-place-step]').forEach((el) => { el.hidden = el.dataset.placeStep !== name; });
  }
  function syncQuestions() {
    $$<HTMLButtonElement>('[data-exp]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.exp === exp)));
    $$<HTMLButtonElement>('[data-chess]').forEach((b) => b.setAttribute('aria-pressed', String(chess !== null && (b.dataset.chess === 'yes') === chess)));
    $('[data-place-actions]').hidden = exp === null || chess === null;
    $('[data-check-start]').hidden = exp === null || exp === 'none';
  }
  function save(route: Route, start: CourseLevel, why: string) {
    const before = readLocal().course;
    changing = false;
    try { localStorage.removeItem('learnRoute'); } catch { }
    render(updateCourse((c) => { c.route = route; c.start = start; c.placedAt = new Date().toISOString(); },
      { overwrite: !!before.route && (before.route !== route || before.start !== start) }), why);
    $('[data-chosen]').scrollIntoView({ block: 'nearest' });
  }
  const whyFor = (start: CourseLevel, checked: boolean) =>
    checked
      ? `ענית נכון על ${score} מתוך 3 בבדיקה, ולכן ${LEVEL_INFO[start].title}.`
      : start === 'beginner' ? 'מתחילים מההתחלה: כל כלי וכל כלל, אחד אחרי השני.' : 'החוקים כבר מוכרים לך, אז מתחילים בבינוניים. רמת המתחילים נשארת פתוחה לרענון.';

  $$<HTMLButtonElement>('[data-exp]').forEach((b) => b.addEventListener('click', () => { exp = b.dataset.exp as Experience; syncQuestions(); }));
  $$<HTMLButtonElement>('[data-chess]').forEach((b) => b.addEventListener('click', () => { chess = b.dataset.chess === 'yes'; syncQuestions(); render(); }));
  $('[data-place-go]').addEventListener('click', () => {
    if (exp === null || chess === null) return;
    const pl = placeFrom(exp, chess);
    save(pl.route, pl.start, whyFor(pl.start, false));
  });

  const checks = $$('[data-check]');
  function showCheck(i: number) {
    checks.forEach((c, j) => { c.hidden = j !== i; });
    $('[data-check-count]').textContent = `שאלה ${i + 1} מתוך ${checks.length}`;
    $$<HTMLButtonElement>('[data-check-answer]', checks[i])[0]?.focus();
  }
  $('[data-check-start]').addEventListener('click', () => { score = 0; showStep('check'); showCheck(0); });
  checks.forEach((c, i) => {
    $$<HTMLButtonElement>('[data-check-answer]', c).forEach((b) => b.addEventListener('click', () => {
      const right = b.dataset.checkAnswer === c.dataset.answer;
      if (right) score++;
      $$<HTMLButtonElement>('[data-check-answer]', c).forEach((x) => {
        x.disabled = true;
        if (x.dataset.checkAnswer === c.dataset.answer) x.dataset.result = 'right';
        else if (x === b) x.dataset.result = 'wrong';
      });
      const why = $('[data-check-why]', c);
      why.hidden = false;
      why.prepend(right ? 'נכון. ' : 'לא בדיוק. ');
      const next = $<HTMLButtonElement>('[data-check-next]', c);
      next.hidden = false;
      next.focus();
    }));
    $('[data-check-next]', c).addEventListener('click', () => {
      if (i < checks.length - 1) return showCheck(i + 1);
      const pl = placeFrom(exp ?? 'rules', !!chess, score);
      save(pl.route, pl.start, whyFor(pl.start, true));
    });
  });
  $('[data-check-skip]').addEventListener('click', () => {
    const pl = placeFrom(exp ?? 'rules', !!chess);
    save(pl.route, pl.start, whyFor(pl.start, false));
  });

  $('[data-manual]').addEventListener('click', () => {
    $<HTMLInputElement>('[data-pick-chess]').checked = chess ?? readLocal().course.route === 'chess';
    showStep('manual');
  });
  $('[data-back-questions]').addEventListener('click', () => showStep('questions'));
  $<HTMLInputElement>('[data-pick-chess]').addEventListener('change', (e) => { chess = (e.target as HTMLInputElement).checked; syncQuestions(); render(); });
  $$<HTMLButtonElement>('[data-pick]').forEach((b) => b.addEventListener('click', () => {
    const start = b.dataset.pick as CourseLevel;
    save($<HTMLInputElement>('[data-pick-chess]').checked ? 'chess' : 'main', start, `בחרת להתחיל ב${LEVEL_INFO[start].title}.`);
  }));

  function render(saved: SyncedProgress = readLocal(), why?: string) {
    const placed = !!saved.course.route;
    const picking = !placed || changing;
    const route: Route = placed && !changing ? saved.course.route! : chess ? 'chess' : 'main';
    const p: SyncedProgress = placed && !changing ? saved : { ...saved, course: { ...saved.course, route } };
    showPath(route);
    $('[data-gate]').hidden = true;
    const xp = xpBreakdown(p, levelCounts).total;
    const r = rankFor(xp);
    $('[data-rank]').hidden = false;
    $('[data-rank-kanji]').textContent = r.rank.kanji;
    $('[data-rank-name]').textContent = r.rank.name;
    $('[data-rank-bar]').style.width = `${r.next ? Math.round((100 * r.into) / r.span) : 100}%`;
    if (r.rank.index > 0) $('[data-rank-share]').replaceChildren(shareButton({ title: `הגעתי לדרגה ${r.rank.name}`, sub: 'במסלול הלימוד האישי של שוגי ישראל', kanji: r.rank.kanji, path: '/course/' }, 'shogi-israel-rank.png', 'btn btn-ghost'));
    $('[data-rank-text]').textContent = r.next
      ? `${xp.toLocaleString('he-IL')} נקודות · עוד ${(r.next.min - xp).toLocaleString('he-IL')} לדרגה ${r.next.name}`
      : `${xp.toLocaleString('he-IL')} נקודות · הדרגה הגבוהה ביותר באתר`;
    $('[data-placement]').hidden = !picking;
    $('[data-chosen]').hidden = picking;
    if (placed) {
      $('[data-chosen-label]').textContent = placeLabel(p.course);
      $('[data-chosen-why]').textContent = why ?? (p.course.route === 'chess' ? ROUTE_INFO.chess.sub : ROUTE_INFO.main.sub);
    }

    const next = nextStep(p, levelCounts);
    const showNext = (placed || hasAnyProgress(p)) && !picking;
    $('[data-next]').hidden = !showNext || !next;
    $('[data-done-all]').hidden = !showNext || !!next;
    if (next) {
      const { unit, step } = next;
      const c = stepCount(step, p, levelCounts);
      $('[data-next-where]').textContent = `${whereLabel(unit)} · ${KIND_LABEL[step.kind]} · ${step.minutes} דק׳${c && c.done ? ` · ${c.done} מתוך ${c.of}` : ''}`;
      $('[data-next-title]').textContent = step.title;
      $('[data-next-why]').textContent = step.why;
      const link = $<HTMLAnchorElement>('[data-next-link]');
      link.href = stepHref(step, p, levelCounts);
      link.dataset.stepLink = step.id;
      $('span', link).textContent = stepState(step, p, levelCounts) === 'todo' && started(step.id, p) ? '⟦המשך|המשיכי⟧' : '⟦התחל|התחילי⟧';
    }

    const total = pathProgress(p, levelCounts);
    $('[data-overall]').hidden = !showNext;
    $('[data-overall-bar]').style.width = `${total.of ? Math.round((100 * total.done) / total.of) : 0}%`;
    $('[data-overall-text]').textContent = `${total.done} מתוך ${total.of} צעדים במסלול`;

    for (const l of LEVELS) {
      const known = unitsOf(l, route).every((u) => stepsFor(u, p.course).every((s) => isKnown(s, p.course)));
      $('[data-level-known]', $(`[data-level="${l}"]`, pathEl())).hidden = !(placed && known);
    }
    for (const u of curriculumFor(route)) {
      const sec = $(`[data-unit="${u.key}"]`, pathEl());
      const visible = new Set(stepsFor(u, p.course).map((s) => s.id));
      for (const s of u.steps) {
        const li = $(`[data-step="${s.id}"]`, sec);
        li.hidden = !visible.has(s.id);
        const state = stepState(s, p, levelCounts);
        li.dataset.state = state;
        li.classList.toggle('is-next', next?.step.id === s.id && showNext);
        $<HTMLAnchorElement>('[data-step-link]', li).href = stepHref(s, p, levelCounts);
        const known = (placed || !!s.known?.includes(route)) && isKnown(s, p.course);
        $('[data-known-tag]', li).hidden = !known || state === 'done';
        $('[data-opt-tag]', li).hidden = known || !isOptional(s, p.course);
        const c = stepCount(s, p, levelCounts);
        $('[data-count]', li).textContent = c && c.done && state === 'todo' ? ` · ${c.done} מתוך ${c.of}` : '';
        $('[data-state-sr]', li).textContent = STATE_SR[state] ? ` · ${STATE_SR[state]}` : '';
        $('[data-xp]', li).hidden = state !== 'todo';
        const skip = $<HTMLButtonElement>('[data-skip]', li);
        skip.hidden = state === 'done' || known;
        skip.textContent = state === 'skipped' ? '⟦בטל|בטלי⟧ סימון' : 'כבר ⟦יודע|יודעת⟧';
        skip.setAttribute('aria-label', `${state === 'skipped' ? '⟦בטל|בטלי⟧ סימון' : 'כבר ⟦יודע|יודעת⟧'}: ${s.title}`);
      }
      const up = unitProgress(u, p, levelCounts);
      const bar = $('[data-unit-progress]', sec);
      bar.hidden = !showNext || up.of === 0;
      $<HTMLElement>('.bar span', bar).style.width = `${up.of ? Math.round((100 * up.done) / up.of) : 0}%`;
      $('.small', bar).textContent = up.done === up.of ? 'הושלם ✓' : `${up.done} מתוך ${up.of}`;
    }
  }

  function started(id: string, p: SyncedProgress): boolean {
    const s = ALL_STEPS.find((x) => x.id === id)!;
    if (s.kind === 'learn') return s.learn!.some((k) => (p.learn.stages[k]?.scores ?? []).some((x) => x > 0));
    if (s.kind === 'tsume') return (p.tsume[String(s.tsume)]?.length ?? 0) > 0;
    return false;
  }

  $('[data-change]').addEventListener('click', () => {
    changing = true;
    const c = readLocal().course;
    chess = c.route === 'chess';
    exp = null;
    showStep('questions');
    syncQuestions();
    render();
    $<HTMLButtonElement>('[data-exp]').focus();
  });

  root.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const skip = t.closest<HTMLButtonElement>('[data-skip]');
    if (skip) {
      const id = skip.closest<HTMLElement>('[data-step]')!.dataset.step!;
      const was = isSkipped(id, readLocal().course.skipped);
      const old = legacyOf(id);
      render(updateCourse((c) => {
        c.skipped = was ? c.skipped.filter((x) => x !== id && x !== old) : [...c.skipped, id].sort();
      }, { overwrite: was }));
      return;
    }
    const link = t.closest<HTMLAnchorElement>('[data-step-link]');
    const id = link?.dataset.stepLink || link?.closest<HTMLElement>('[data-step]')?.dataset.step;
    const step = id && ALL_STEPS.find((s) => s.id === id);
    if (step && (step.kind === 'read' || step.kind === 'try')) markSeen(step.id);
  });

  if (asked) {
    try { localStorage.setItem('learnRoute', asked); } catch { }
    history.replaceState(null, '', location.pathname + location.hash);
  }
  if (signedIn) {
    const c = readLocal().course;
    if (asked && c.route && c.route !== asked) {
      try { localStorage.removeItem('learnRoute'); } catch { }
      const p = updateCourse((x) => { x.route = asked; x.placedAt = new Date().toISOString(); }, { overwrite: true });
      render(p, asked === 'chess' ? 'עברת למסלול לשחקני שחמט: רק מה שחדש לך, וכל הסבר משווה לשחמט. ההתקדמות שלך נשארת.' : 'עברת למסלול הרגיל. ההתקדמות שלך נשארת.');
    } else {
      render();
    }
    syncQuestions();
    scrollToHash();
    document.addEventListener('progress-synced', () => render());
    window.addEventListener('pageshow', (e) => { if (e.persisted) render(); });
  } else if (chess) {
    showPath('chess');
    scrollToHash();
  }
</script>

<style>
  .page { padding-top: 36px; max-width: 760px; }
  [hidden] { display: none !important; }
  h1 { margin: 6px 0 8px; }
  .phases-note { margin: -12px 0 24px; display: flex; align-items: center; }
  .lead { margin: 0 0 24px; font-size: 18px; line-height: 1.7; color: var(--ink-2); }
  .link { appearance: none; background: none; border: 0; padding: 0; font: inherit; color: var(--seal); text-decoration: underline; cursor: pointer; }
  .card { background: var(--washi-2); border: 1px solid var(--rule); border-radius: 10px; padding: 18px 20px; }

  .gate { margin: 0 0 8px; display: flex; flex-direction: column; gap: 8px; border-inline-start: 4px solid var(--seal); }
  .gate h2 { margin: 0; font-size: 22px; }
  .gate p { margin: 0; color: var(--ink-2); line-height: 1.6; }
  .gate-cta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px; margin: 6px 0 !important; }

  .rank { display: flex; gap: 16px; align-items: flex-start; margin: 0 0 16px; }
  .rank-kanji {
    flex-shrink: 0; width: 72px; height: 72px; border-radius: 50%; display: grid; place-items: center;
    background: var(--seal); color: var(--on-seal); font: 700 22px/1 var(--f-kanji); writing-mode: vertical-rl; letter-spacing: 1px;
  }
  .rank-body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4px; }
  .rank-body p { margin: 0; }
  .rank-name { font: 800 26px/1.2 var(--f-display); }
  .rank-line { display: flex; align-items: center; }
  .rank-how summary { cursor: pointer; color: var(--seal); margin-top: 4px; }
  .rank-how ul { margin: 8px 0; padding-inline-start: 20px; color: var(--ink-2); }
  .rank-how li { margin-bottom: 4px; }
  .xp { color: var(--seal); }

  .placement { margin: 0 0 16px; display: flex; flex-direction: column; gap: 4px; border-inline-start: 4px solid var(--seal); }
  .placement h2 { font-size: 22px; margin: 0 0 8px; }
  .placement p { margin: 0; }
  [data-place-step] { display: flex; flex-direction: column; gap: 14px; }
  .q { border: 0; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .q legend { font-weight: 700; font-size: 18px; margin-bottom: 8px; padding: 0; }
  .opts { display: grid; gap: 10px; }
  @media (min-width: 700px) { .opts { grid-template-columns: repeat(3, minmax(0, 1fr)); } .opts.two { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .opt {
    appearance: none; text-align: start; font: inherit; color: var(--ink); cursor: pointer;
    display: flex; flex-direction: column; gap: 4px; min-height: 64px; padding: 12px 16px;
    background: var(--washi); border: 1.5px solid var(--ink); border-radius: 10px;
  }
  .opt strong { font-size: 17px; }
  .opt:hover:not(:disabled) { background: var(--washi-2); }
  .opt[aria-pressed="true"] { border-color: var(--seal); box-shadow: inset 0 0 0 1.5px var(--seal); }
  .opt:disabled { cursor: default; opacity: .7; }
  .opt[data-result="right"] { border-color: var(--ok-text); box-shadow: inset 0 0 0 1.5px var(--ok-text); opacity: 1; }
  .opt[data-result="wrong"] { border-style: dashed; opacity: 1; }
  .place-actions { display: flex; flex-wrap: wrap; gap: 8px; }
  .check { display: flex; flex-direction: column; gap: 12px; }
  .check-q { font-size: 18px; }
  .check-why { color: var(--ink-2); line-height: 1.6; }
  .check .btn { align-self: flex-start; }
  .chess-box { display: flex; align-items: center; gap: 8px; }
  .chess-box input { width: 20px; height: 20px; accent-color: var(--seal); }

  .chosen p { margin: 0 0 4px; }
  .chosen { margin-bottom: 16px; }

  .next { margin: 0 0 16px; display: flex; flex-direction: column; gap: 6px; border-inline-start: 4px solid var(--seal); }
  .next .eyebrow { margin: 0; }
  .next h2 { margin: 0; font-size: 24px; }
  .next p { margin: 0; color: var(--ink-2); line-height: 1.6; }
  .next .btn { align-self: flex-start; margin-top: 8px; }
  .done-all { margin: 0 0 16px; }
  .done-all h2 { margin: 0 0 6px; }
  .done-all p { margin: 0 0 6px; color: var(--ink-2); }

  .bar { height: 8px; border-radius: 999px; background: var(--rule); overflow: hidden; }
  .bar span { display: block; height: 100%; width: 0; background: var(--seal); border-radius: inherit; transition: width .3s; }
  .overall { margin: 0 0 8px; }
  .overall p { margin: 6px 0 0; }
  .save-note { margin: 0 0 8px; }

  .level-nav { display: flex; flex-wrap: wrap; gap: 6px 16px; margin: 24px 0 0; }
  .level { margin-top: 48px; scroll-margin-top: 16px; }
  .level-head { border-bottom: 3px solid var(--ink); padding-bottom: 12px; }
  .level-tag { margin: 0; font-size: 14px; font-weight: 700; color: var(--seal); display: flex; align-items: center; }
  .level-head h2 { margin: 2px 0 6px; font-size: clamp(30px, 6vw, 38px); }
  .level-goal { margin: 0; color: var(--ink-2); line-height: 1.65; }
  .level-known { margin: 8px 0 0; color: var(--muted); }
  .unit { margin-top: 28px; scroll-margin-top: 16px; }
  .unit-head h3 { margin: 0 0 4px; font-size: 22px; }
  .unit-goal { margin: 0 0 10px; color: var(--ink-2); line-height: 1.65; }
  .unit-progress { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
  .unit-progress .bar { flex: 1; max-width: 240px; }

  .steps { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--rule); }
  .step { display: flex; gap: 12px; align-items: flex-start; padding: 14px 0; border-bottom: 1px solid var(--rule); }
  .mark {
    flex-shrink: 0; width: 26px; height: 26px; margin-top: 2px; border-radius: 50%;
    border: 2px solid var(--rule); display: grid; place-items: center; font-size: 15px; font-weight: 700;
  }
  .step[data-state="done"] .mark { background: var(--ok-text); border-color: var(--ok-text); color: var(--washi); }
  .step[data-state="done"] .mark::after { content: '✓'; }
  .step[data-state="skipped"] .mark { border-style: dashed; border-color: var(--muted); color: var(--muted); }
  .step[data-state="skipped"] .mark::after { content: '–'; }
  .step.is-next .mark { border-color: var(--seal); background: var(--seal); }
  .step.is-next { background: linear-gradient(to left, transparent, var(--washi-2)); }
  .step-body { flex: 1; min-width: 0; }
  .step-title { font-weight: 700; font-size: 17px; color: var(--ink); }
  .step-title:hover { color: var(--seal); }
  .step[data-state="skipped"] .step-title { color: var(--muted); }
  .step-meta { margin: 2px 0 4px; }
  .step-why { margin: 0; color: var(--ink-2); line-height: 1.55; font-size: 15px; }
  .step-skip {
    appearance: none; flex-shrink: 0; cursor: pointer; font: inherit; font-size: 14px; color: var(--muted);
    background: none; border: 1px solid var(--rule); border-radius: 999px; padding: 6px 12px; min-height: 36px;
  }
  .step-skip:hover { color: var(--ink); border-color: var(--ink); }
  .foot { margin-top: 32px; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
</style>
