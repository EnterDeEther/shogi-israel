// Facts checked on lishogi.org on 2026-10-24 (FAQ, /rating-ranks, /tournament/help, /new-player, the team pages).
// Lishogi changes without notice: re-check the numbers below before editing them.
const TEAM = 'https://lishogi.org/team/---shogi-israel';
const WHATSAPP = 'https://chat.whatsapp.com/Hl05iCdO2OY1rJIETuAien';

const toc = [
  { id: 'what', label: 'מה זה ליש׳וגי' },
  { id: 'signup', label: 'פתיחת חשבון' },
  { id: 'play', label: 'משחק ראשון' },
  { id: 'friends', label: 'משחק עם חברים' },
  { id: 'team', label: 'הקבוצה והליגה הישראלית' },
  { id: 'tournaments', label: 'סוגי טורנירים' },
  { id: 'ratings', label: 'דירוג, דרגות וטבלאות' },
  { id: 'analysis', label: 'ניתוח משחקים ומנוע' },
  { id: 'fair', label: 'משחק הוגן' },
];

// lishogi.org/rating-ranks: a rank shows only once the rating is stable.
const ranks = [
  ['15 קיו', '400–474'], ['14 קיו', '475–549'], ['13 קיו', '550–624'], ['12 קיו', '625–699'],
  ['11 קיו', '700–774'], ['10 קיו', '775–849'], ['9 קיו', '850–924'], ['8 קיו', '925–999'],
  ['7 קיו', '1000–1074'], ['6 קיו', '1075–1149'], ['5 קיו', '1150–1224'], ['4 קיו', '1225–1299'],
  ['3 קיו', '1300–1374'], ['2 קיו', '1375–1449'], ['1 קיו', '1450–1549'],
  ['1 דאן', '1550–1649'], ['2 דאן', '1650–1749'], ['3 דאן', '1750–1849'], ['4 דאן', '1850–1974'],
  ['5 דאן', '1975–2124'], ['6 דאן', '2125–2274'], ['7 דאן', '2275–2499'], ['8 דאן', '2500 ומעלה'],
