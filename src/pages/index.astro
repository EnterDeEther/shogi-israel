---
import Base from '../layouts/Base.astro';
import LearnerHome from '../components/LearnerHome.astro';
import HomeStory from '../components/HomeStory.astro';
import HomeFaq from '../components/HomeFaq.astro';
import FaqDialog from '../components/FaqDialog.astro';
import BackToTop from '../components/BackToTop.astro';
import NewsBar from '../components/NewsBar.astro';
import { RULES_COURSE } from '../lib/course';
import { pageExists } from '../lib/live';
import { accountsEnabled, AUTH_STORAGE_KEY } from '../lib/account-config';
import { RETURNING_GUESS } from '../lib/visitor';
import { WEEK_LENGTH } from '../tsume/week';
import { createHash } from 'node:crypto';

const hasTry = pageExists('/try/');
const first = hasTry ? '/try/' : `/rules/${RULES_COURSE[0].slug}/`;
const accountsOn = pageExists('/account/') && accountsEnabled;
const hasCourse = pageExists('/course/');
const tsume = import.meta.glob<{ default: unknown[] }>('../tsume/data/mate*.json', { eager: true });
const weekCount = tsume[`../tsume/data/mate${WEEK_LENGTH}.json`]?.default.length ?? 0;
if (hasCourse) Astro.csp?.insertScriptHash(`sha256-${createHash('sha256').update(RETURNING_GUESS).digest('base64')}`);
---
<Base
  title="שוגי ישראל"
  description="השחמט היפני, בעברית ומאפס. חוקים בסיסיים בשיעורים קצרים ואינטראקטיביים, בחינם ובלי הרשמה, וקהילה ישראלית של שחקני שוגי."
>
  {hasCourse && <script is:inline data-auth={accountsOn ? AUTH_STORAGE_KEY : ''} set:html={RETURNING_GUESS}></script>}

  <div class="home">
    <HomeStory first={first} />
    <NewsBar class="wrap" />
    <HomeFaq />
    {hasCourse && <LearnerHome weekCount={weekCount} accounts={accountsOn} />}
  </div>
  <FaqDialog />
  <BackToTop />
</Base>

<style>
  :global([data-learner-only]) { display: none; }
  :global(html[data-learner] [data-learner-only]) { display: revert; }
  :global(html[data-learner] [data-newcomer]) { display: none; }

  @media (hover: none), (pointer: coarse) {
    :global(html:not([data-learner]):not(.tour-on):has([data-story])) { scroll-snap-type: y mandatory; }
  }
  :global(html:has(main :focus-visible)) { scroll-snap-type: none !important; }
  :global(html[data-snap-free]) { scroll-snap-type: none !important; }
  .home > :global([data-news-bar]) { margin-top: 56px; }
  :global(html[data-learner]) .home > :global([data-news-bar]) { margin-top: 14px; }
</style>
