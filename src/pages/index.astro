---
import Base from '../layouts/Base.astro';
import Board from '../components/Board.astro';
import { getCollection } from 'astro:content';
import { RULES_COURSE, pad } from '../lib/course';
import { pageExists, LISHOGI_TEAM } from '../lib/live';
import { liveSections, isLive, ACCOUNT } from '../lib/nav';

const live = new Set((await getCollection('rules')).map((e) => e.id));
const START = 'lnsgkgsnl/1r5b1/ppppppppp/9/9/9/PPPPPPPPP/1B5R1/LNSGKGSNL b - 1';
const first = `/rules/${RULES_COURSE[0].slug}/`;
// Playing happens here first; Lishogi is for public games and tournaments.
const hasPlay = pageExists('/play/');
const hasAccount = pageExists('/account/');
const sections = liveSections();
---
<Base
  title="שוגי ישראל"
  description="השחמט היפני, בעברית ומאפס. חוקים בסיסיים בשיעורים קצרים ואינטראקטיביים, בחינם ובלי הרשמה, וקהילה ישראלית של שחקני שוגי."
>
  <section class="hero wrap">
    <div class="hero-text">
      <p class="eyebrow">הקהילה הישראלית של השוגי, השחמט היפני</p>
      <h1>ברוכים הבאים לשוגי ישראל</h1>
      <p class="lead">הבית של שחקני השוגי בישראל. לומדים את השחמט היפני בעברית ומאפס, משחקים כאן באתר, ופוגשים שחקנים אחרים. הכול בחינם.</p>
      <div class="cta">
        <a class="btn" href={first}>
          <span>התחילו בחוקים הבסיסיים</span>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"></path></svg>
        </a>
        {hasPlay && <a class="btn btn-ghost" href="/play/">כבר יודעים לשחק? שחקו נגד המחשב</a>}
        <a class="btn btn-ghost" href="#offer">
          <span>מה יש באתר? סקירה קצרה</span>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6"></path></svg>
        </a>
        <p class="small muted">8 שיעורים קצרים · בלי הרשמה · ההתקדמות נשמרת רק במכשיר שלכם</p>
      </div>
    </div>
    <div class="hero-board">
      <Board sfen={START} />
    </div>
  </section>

  <section class="wrap block" aria-labelledby="offer">
    <h2 id="offer">מה יש באתר</h2>
    <ul class="offer">
      {sections.map((s) => (
        <li class="card">
          <h3>{s.label}</h3>
          {s.blurb && <p>{s.blurb}</p>}
          <ul>
            {s.links.map((l) => (
              <li><a href={l.href} rel={l.external ? 'noopener' : undefined}>{l.label}{l.external && <span class="ext" aria-hidden="true"> ↗</span>}</a></li>
            ))}
          </ul>
        </li>
      ))}
      {isLive(ACCOUNT) && (
        <li class="card">
          <h3>החשבון שלי</h3>
          <p>ההתקדמות והמשחקים נשמרים בכל מכשיר. לא חובה, והכול עובד גם בלי.</p>
          <ul><li><a href="/account/">כניסה או הרשמה</a></li></ul>
        </li>
      )}
    </ul>
  </section>

  <section class="wrap block" aria-labelledby="three">
    <h2 id="three">שלושה דברים שעושים את השוגי לשוגי</h2>
    <ol class="three">
      <li>
        <span class="num" lang="ja" aria-hidden="true">一</span>
        <div><h3>לוח 9×9, עשרים כלים לכל צד</h3><p>מוכר מספיק כדי להתחיל, שונה מספיק כדי להפתיע.</p></div>
      </li>
      <li>
        <span class="num" lang="ja" aria-hidden="true">二</span>
        <div><h3>הצנחה</h3><p>כלי שנלכד עובר לידיים שלכם. בתורכם אפשר להניח אותו כמעט בכל משבצת פנויה.</p></div>
      </li>
      <li>
        <span class="num" lang="ja" aria-hidden="true">三</span>
        <div><h3>הכתרה</h3><p>רוב הכלים מתחזקים כשהם נכנסים לשלוש השורות האחרונות של היריב.</p></div>
      </li>
    </ol>
  </section>

  <section class="wrap block" aria-labelledby="course">
    <div class="head-row">
      <h2 id="course">חוקים בסיסיים</h2>
      <a class="small" href="/rules/">לכל השיעורים</a>
    </div>
    <ol class="rows course">
      {RULES_COURSE.map((l, i) => (
        <li>
          {live.has(l.slug) ? (
            <a href={`/rules/${l.slug}/`} data-progress={l.slug}>
              <span class="row-num">{pad(l.n)}</span>
              <span class="row-title">{l.title}</span>
              <span class="row-tag" data-tag>{i === 0 ? 'התחילו כאן' : ''}</span>
            </a>
          ) : (
            <span class="row">
              <span class="row-num">{pad(l.n)}</span>
              <span class="row-title muted">{l.title}</span>
              <span class="row-tag soon">בקרוב</span>
            </span>
          )}
        </li>
      ))}
    </ol>
  </section>

  {hasPlay && (
    <section id="play" class="wrap block" aria-labelledby="play-h">
      <h2 id="play-h">משחקים כאן, באתר</h2>
      <ul class="rows links play">
        <li><a href="/play/"><span class="row-title"><strong>שחקו נגד המחשב</strong></span><span class="small muted">עשר רמות, ממתחילים ועד מתקדמים. ישר בדפדפן, בחינם</span></a></li>
        {hasAccount && <li><a href="/account/"><span class="row-title"><strong>פתחו חשבון בשוגי ישראל</strong></span><span class="small muted">ההתקדמות והמשחקים שלכם נשמרים בכל מכשיר</span></a></li>}
        <li><span class="row"><span class="row-title"><strong>משחק מול חבר</strong></span><span class="small muted">בקרוב: שולחים קישור הזמנה ומשחקים</span></span></li>
      </ul>
    </section>
  )}

  <section id="community" class="wrap block" aria-labelledby="community-h">
    <div class="community">
      <h2 id="community-h">משחקים עם ישראלים</h2>
      <p>אנחנו קהילה קטנה ומתחילה. בואו להיות מהראשונים.</p>
      <ul class="rows links">
        <li><a href="https://chat.whatsapp.com/Hl05iCdO2OY1rJIETuAien" rel="noopener"><span class="row-title"><strong>קהילת הוואטסאפ</strong></span><span class="small muted">עדכונים, שאלות ומפגשים</span></a></li>
        <li><a href="https://www.instagram.com/shogi.israel/" rel="noopener"><span class="row-title"><strong>אינסטגרם</strong></span><bdi dir="ltr" class="small muted">@shogi.israel</bdi></a></li>
        <li><span class="row"><span class="row-title"><strong>מפגשי היכרות בתל אביב</strong></span><span class="small muted">בקרוב</span></span></li>
        <li><a href={LISHOGI_TEAM} rel="noopener"><span class="row-title"><strong>הקבוצה שלנו בליש׳וגי</strong></span><span class="small muted">טורנירים ויריבים מכל העולם</span></a></li>
      </ul>
    </div>
  </section>
</Base>

<script>
  // "Done" marks from this device's progress (merged with the account's when signed in).
  const markDone = () => {
    document.querySelectorAll<HTMLElement>('[data-progress]').forEach((a) => {
      let done = false;
      try { done = localStorage.getItem(`done:${a.dataset.progress}`) === '1'; } catch {}
      const tag = a.querySelector<HTMLElement>('[data-tag]');
      if (done && tag) tag.textContent = 'הושלם ✓';
    });
  };
  markDone();
  document.addEventListener('progress-synced', markDone);
</script>

<style>
  .hero { display: grid; gap: 32px; padding-top: 36px; }
  .hero-text { display: flex; flex-direction: column; gap: 16px; }
  .hero h1 { font-size: clamp(36px, 8.5vw, 60px); line-height: 1.1; }
  .lead { margin: 0; font-size: 18px; line-height: 1.7; color: var(--ink-2); max-width: 34em; }
  .cta { display: flex; flex-direction: column; gap: 10px; padding-top: 8px; }
  .cta .btn { align-self: stretch; }
  .cta p { margin: 0; text-align: center; }
  .hero-board :global(.board-fig) { margin: 0; }
  @media (min-width: 900px) {
    .hero { grid-template-columns: 1.1fr 1fr; align-items: center; gap: 64px; padding-top: 72px; }
    .cta .btn { align-self: flex-start; min-width: 340px; }
    .cta p { text-align: start; }
    .hero-board :global(.board-fig) { margin-inline-start: auto; }
  }

  .block { margin-top: 64px; }
  #offer { scroll-margin-top: 16px; }
  .block > h2, .head-row { margin-bottom: 18px; }
  .head-row { display: flex; align-items: baseline; justify-content: space-between; }

  .three { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--rule); display: grid; }
  .three li { display: flex; gap: 16px; padding: 18px 0; border-bottom: 1px solid var(--rule); }
  .three .num { font-size: 26px; color: var(--seal); width: 34px; flex-shrink: 0; line-height: 1.3; }
  .three h3 { margin-bottom: 4px; }
  .three p { margin: 0; color: var(--ink-2); line-height: 1.6; }
  @media (min-width: 900px) {
    .three { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; border-top: 0; }
    .three li { flex-direction: column; border-top: 2px solid var(--ink); border-bottom: 0; }
  }

  .offer { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .card { background: var(--washi-2); border: 1px solid var(--rule); border-radius: 8px; padding: 16px 18px 12px; }
  .card h3 { font-family: var(--f-display); font-size: 21px; font-weight: 800; margin-bottom: 4px; }
  .card p { margin: 0 0 8px; color: var(--ink-2); line-height: 1.55; font-size: 16px; }
  .card ul { list-style: none; margin: 0; padding: 0; }
  .card li a { display: flex; align-items: center; min-height: 44px; font-weight: 700; color: var(--ink); text-decoration: none; border-top: 1px solid var(--rule); }
  .card li a:hover { color: var(--seal); text-decoration: underline; }
  .ext { color: var(--muted); font-weight: 400; }
  @media (min-width: 700px) { .offer { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1000px) { .offer { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; } }

  .course, .play { max-width: 720px; }
  .community { background: var(--washi-2); border-radius: 8px; padding: 28px 22px; max-width: 720px; }
  .community h2 { margin-bottom: 8px; }
  .community > p { margin: 0 0 16px; color: var(--ink-2); }
  .links { border-top-color: var(--rule); }
  .links a, .links .row { justify-content: space-between; min-height: 52px; }
  .play a, .play .row { flex-direction: column; align-items: flex-start; justify-content: center; gap: 2px; padding-block: 12px; }
</style>
