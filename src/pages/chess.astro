<script>
  import { choosePieceSet, markChessPlayer, savedPieceSet } from '../lib/piece-set';
  markChessPlayer();
  const ask = document.querySelector<HTMLElement>('[data-chess-ask]');
  const ASKED = 'chessPiecesAsked';
  let asked = false;
  try { asked = localStorage.getItem(ASKED) === '1'; } catch { }
  if (ask && !asked && savedPieceSet() !== 'chess') {
    ask.hidden = false;
    ask.querySelectorAll<HTMLButtonElement>('[data-ask]').forEach((b) => b.addEventListener('click', () => {
      const set = b.dataset.ask === 'hebrew' ? 'hebrew' : 'chess';
      choosePieceSet(set);
      try { localStorage.setItem(ASKED, '1'); } catch { }
      ask.querySelector<HTMLElement>('[data-ask-q]')!.hidden = true;
      const done = ask.querySelector<HTMLElement>(`[data-ask-done="${set}"]`)!;
      done.hidden = false;
      done.setAttribute('tabindex', '-1');
      done.focus({ preventScroll: true });
    }));
  }
  document.querySelectorAll('[data-chess-intent]').forEach((a) => a.addEventListener('click', () => {
    try { localStorage.setItem('learnRoute', 'chess'); } catch { }
  }));
</script>

