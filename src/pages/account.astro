---
import Base from '../layouts/Base.astro';
import { accountsEnabled } from '../lib/account-config';
import { stages } from '../learn/categories';

// Levels per Learn stage, for the stats (so the page doesn't ship the whole lesson engine).
const levelCounts = Object.fromEntries(stages.map((s) => [s.key, s.levels.length]));
---
<Base title="החשבון שלי" description="כניסה לחשבון בשוגי ישראל: ההתקדמות בשיעורים נשמרת בכל מכשיר, וכינוי לטבלאות הדירוג." noindex>
  <div class="wrap page" data-account data-level-counts={JSON.stringify(levelCounts)}>
    {!accountsEnabled && (
      <section>
        <h1>החשבון שלי</h1>
        <p class="lead">החשבונות בדרך. בינתיים ההתקדמות שלכם נשמרת בדפדפן הזה, בלי הרשמה.</p>
      </section>
    )}

    {accountsEnabled && (
      <>
        <p class="muted" data-view="loading">טוען…</p>

        <section data-view="signin" hidden>
          <h1 data-signin-title>כניסה לחשבון</h1>
          <p class="lead">עם חשבון, ההתקדמות בשיעורים נשמרת ועוברת איתכם לכל מכשיר. בהמשך: כינוי בטבלאות הדירוג, סטטיסטיקה אישית ומשחקים מול חברים.</p>
          <div class="seg tabs" role="group" aria-label="כניסה או הרשמה">
            <button type="button" data-mode="signin" aria-pressed="true">כניסה</button>
            <button type="button" data-mode="signup" aria-pressed="false">הרשמה</button>
          </div>
          <form class="form" data-auth-form novalidate>
            <label for="acc-email">כתובת מייל</label>
            <input id="acc-email" name="email" type="email" dir="ltr" autocomplete="email" inputmode="email" required />
            <label for="acc-pass">סיסמה</label>
            <input id="acc-pass" name="password" type="password" dir="ltr" autocomplete="current-password" minlength="8" required aria-describedby="acc-pass-help" />
            <p id="acc-pass-help" class="small muted" data-signup-only hidden>לפחות 8 תווים. עדיף משפט קצר שקל לכם לזכור.</p>
            <button type="submit" class="btn wide"><span data-submit-label>כניסה</span></button>
            <p class="err" role="alert" data-err></p>
          </form>
          <p class="small" data-signin-only><button type="button" class="link" data-forgot>שכחתם סיסמה?</button></p>
          <p class="small muted">מה שכבר עשיתם בדפדפן הזה יישמר בחשבון. בהרשמה אתם מסכימים ל<a href="/privacy/">מדיניות הפרטיות</a>. אנחנו שומרים רק את המייל, הכינוי וההתקדמות שלכם.</p>
        </section>

        <section data-view="forgot" hidden>
          <h1>איפוס סיסמה</h1>
          <p class="lead">הכניסו את המייל של החשבון, ונשלח לכם קישור לבחירת סיסמה חדשה.</p>
          <form class="form" data-forgot-form novalidate>
            <label for="acc-forgot-email">כתובת מייל</label>
            <input id="acc-forgot-email" name="email" type="email" dir="ltr" autocomplete="email" inputmode="email" required />
            <button type="submit" class="btn wide"><span>שלחו לי קישור</span></button>
            <p class="err" role="alert" data-err></p>
          </form>
          <p class="small"><button type="button" class="link" data-back>חזרה לכניסה</button></p>
        </section>

        <section data-view="sent" hidden>
          <h1>בדקו את המייל</h1>
          <p class="lead" data-sent-text></p>
          <p class="muted small">לא הגיע? בדקו בתיקיית הספאם, או חכו כמה דקות ונסו שוב.</p>
          <p class="small"><button type="button" class="link" data-back>חזרה לכניסה</button></p>
        </section>

        <section data-view="newpass" hidden>
          <h1>סיסמה חדשה</h1>
          <form class="form" data-newpass-form novalidate>
            <label for="acc-newpass">הסיסמה החדשה</label>
            <input id="acc-newpass" name="password" type="password" dir="ltr" autocomplete="new-password" minlength="8" required aria-describedby="acc-newpass-help" />
            <p id="acc-newpass-help" class="small muted">לפחות 8 תווים.</p>
            <button type="submit" class="btn wide"><span>שמירה</span></button>
            <p class="err" role="alert" data-err></p>
          </form>
          <p class="small" data-newpass-cancel hidden><button type="button" class="link">ביטול</button></p>
        </section>

        <section data-view="nickname" hidden>
          <h1 data-nick-title>בחרו כינוי</h1>
          <p class="lead">הכינוי יופיע בטבלאות הדירוג ובמשחקים מול חברים. כל אחד יכול לראות אותו, אז עדיף לא את השם המלא.</p>
          <form class="form" data-nick-form novalidate>
            <label for="acc-nick">כינוי</label>
            <input id="acc-nick" name="nickname" autocomplete="nickname" minlength="3" maxlength="16" required aria-describedby="acc-nick-help" />
            <p id="acc-nick-help" class="small muted">3 עד 16 תווים: אותיות בעברית או באנגלית, ספרות, <bdi dir="ltr">_</bdi> או <bdi dir="ltr">-</bdi>.</p>
            <button type="submit" class="btn wide"><span>שמירה</span></button>
            <p class="err" role="alert" data-err></p>
          </form>
          <p class="small" data-nick-cancel hidden><button type="button" class="link">ביטול</button></p>
        </section>

        <section data-view="home" hidden>
          <p class="eyebrow">החשבון שלי</p>
          <h1><bdi data-nickname></bdi></h1>
          <p class="muted small">מחוברים בתור <bdi dir="ltr" data-email></bdi></p>

          <h2>ההתקדמות שלי</h2>
          <dl class="stats">
            <div><dt>כוכבים בשיעורים</dt><dd><bdi dir="ltr" data-stat="stars"></bdi></dd></div>
            <div><dt>תרגילים שפתרתם</dt><dd><bdi dir="ltr" data-stat="levels"></bdi></dd></div>
            <div><dt>שלבים שהשלמתם</dt><dd><bdi dir="ltr" data-stat="stages"></bdi></dd></div>
            <div><dt>שיעורים בקורס החוקים</dt><dd><bdi dir="ltr" data-stat="rules"></bdi></dd></div>
          </dl>
          <p class="small muted" data-synced>ההתקדמות נשמרת בחשבון ומתעדכנת בכל מכשיר שבו אתם מחוברים.</p>

          <h2>משחקים ודירוג</h2>
          <dl class="stats" data-games hidden>
            <div><dt>משחקים</dt><dd data-stat="played"></dd></div>
            <div><dt>ניצחונות</dt><dd data-stat="wins"></dd></div>
            <div><dt>הפסדים</dt><dd data-stat="losses"></dd></div>
            <div><dt>דירוג</dt><dd data-stat="rating"></dd></div>
          </dl>
          <p class="muted" data-no-games>עוד לא שיחקתם. משחק נגד המחשב יגיע בקרוב, ואיתו סטטיסטיקה ודירוג.</p>

          <h2>הגדרות</h2>
          <div class="actions">
            <button type="button" class="btn btn-ghost" data-rename><span>שינוי כינוי</span></button>
            <button type="button" class="btn btn-ghost" data-changepass><span>שינוי סיסמה</span></button>
            <button type="button" class="btn btn-ghost" data-signout><span>יציאה</span></button>
          </div>
          <p class="small muted">ביציאה, ההתקדמות נמחקת מהדפדפן הזה ונשארת שמורה בחשבון.</p>
          <details class="danger">
            <summary>מחיקת החשבון</summary>
            <p>המחיקה סופית: הכינוי, ההתקדמות וכל המשחקים יימחקו מהשרת ולא יהיה אפשר לשחזר אותם.</p>
            <button type="button" class="btn danger-btn" data-delete><span>מחקו את החשבון שלי</span></button>
            <p class="err" role="alert" data-err></p>
          </details>
        </section>
      </>
    )}
  </div>
</Base>

<script>
  import { accountsEnabled } from '../lib/account-config';
  import { stats } from '../lib/progress-sync';

  const root = document.querySelector<HTMLElement>('[data-account]')!;
  if (accountsEnabled) void start();

  async function start() {
    const acc = await import('../lib/account');
    const levelCounts = JSON.parse(root.dataset.levelCounts || '{}');
    const $ = <T extends HTMLElement>(sel: string, scope: ParentNode = root) => scope.querySelector<T>(sel)!;
    const views = [...root.querySelectorAll<HTMLElement>('[data-view]')];
    const show = (name: string) => {
      views.forEach((v) => { v.hidden = v.dataset.view !== name; });
      const v = views.find((x) => x.dataset.view === name);
      v?.querySelector<HTMLElement>('input, h1')?.focus({ preventScroll: true });
    };
    const fail = (view: string, msg: string) => { $(`[data-view="${view}"] [data-err]`).textContent = msg; };
    const busy = (form: HTMLElement, on: boolean) => form.querySelector<HTMLButtonElement>('button[type=submit], [data-delete]')!.disabled = on;
    let profile: Awaited<ReturnType<typeof acc.getProfile>> = null;

    // Arriving from a confirmation or reset link: let the client finish the sign-in first.
    let recovering = false;
    const { data: { subscription } } = acc.supabase().auth.onAuthStateChange((event) => {
      // the callback must not await Supabase calls itself: defer the work
      if (event === 'PASSWORD_RECOVERY') { recovering = true; setTimeout(() => askNewPassword(true)); }
      else if (event === 'SIGNED_IN' && !recovering) setTimeout(() => void route());
    });
    window.addEventListener('pagehide', () => subscription.unsubscribe());

    async function route() {
      recovering = false;
      const session = await acc.getSession();
      if (!session) return show('signin');
      root.querySelectorAll('[data-email]').forEach((e) => { e.textContent = session.user.email ?? ''; });
      profile = await acc.getProfile(session.user.id);
      const progress = (await acc.syncProgress()) ?? acc.readLocal();
      if (!profile) return askNickname(true);
      const s = stats(progress, levelCounts);
      $('[data-nickname]').textContent = profile.nickname;
      $('[data-stat="stars"]').textContent = `${s.stars} / ${s.maxStars}`;
      $('[data-stat="levels"]').textContent = `${s.levelsDone} / ${s.levels}`;
      $('[data-stat="stages"]').textContent = `${s.stagesDone} / ${s.stages}`;
      $('[data-stat="rules"]').textContent = String(s.rulesDone);
      const g = await acc.gameSummary();
      $('[data-games]').hidden = g.played === 0;
      $('[data-no-games]').hidden = g.played > 0;
      $('[data-stat="played"]').textContent = String(g.played);
      $('[data-stat="wins"]').textContent = String(g.wins);
      $('[data-stat="losses"]').textContent = String(g.losses);
      $('[data-stat="rating"]').textContent = String(profile.rating);
      show('home');
    }

    function askNickname(isNew: boolean) {
      $('[data-nick-title]').textContent = isNew ? 'בחרו כינוי' : 'שינוי כינוי';
      $<HTMLInputElement>('#acc-nick').value = profile?.nickname ?? '';
      $('[data-nick-cancel]').hidden = isNew;
      fail('nickname', '');
      show('nickname');
    }

    // ---------- sign in / sign up ----------
    let mode: 'signin' | 'signup' = 'signin';
    const setMode = (m: typeof mode) => {
      mode = m;
      root.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.mode === m)));
      $('[data-signin-title]').textContent = m === 'signin' ? 'כניסה לחשבון' : 'פתיחת חשבון';
      $('[data-submit-label]').textContent = m === 'signin' ? 'כניסה' : 'פתיחת חשבון';
      $('[data-signup-only]').hidden = m === 'signin';
      $('[data-signin-only]').hidden = m === 'signup';
      $<HTMLInputElement>('#acc-pass').autocomplete = m === 'signin' ? 'current-password' : 'new-password';
      fail('signin', '');
    };
    root.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((b) =>
      b.addEventListener('click', () => setMode(b.dataset.mode as typeof mode)));

    const validEmail = (e: string) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(e);
    const authForm = $<HTMLFormElement>('[data-auth-form]');
    authForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = $<HTMLInputElement>('#acc-email').value.trim();
      const password = $<HTMLInputElement>('#acc-pass').value;
      if (!validEmail(email)) return fail('signin', 'הכתובת לא נראית תקינה. בדקו אותה ונסו שוב.');
      if (password.length < 8) return fail('signin', 'הסיסמה צריכה לפחות 8 תווים.');
      busy(authForm, true);
      if (mode === 'signin') {
        const { error } = await acc.signIn(email, password);
        busy(authForm, false);
        if (!error) return; // onAuthStateChange routes on SIGNED_IN
        if (error.code === 'email_not_confirmed') return fail('signin', 'עוד לא אישרתם את המייל. חפשו אצלכם מייל מאיתנו ולחצו על הקישור שבו.');
        if (error.status === 429) return fail('signin', 'יותר מדי ניסיונות. חכו כמה דקות ונסו שוב.');
        return fail('signin', 'המייל או הסיסמה לא נכונים.');
      }
      const { data, error } = await acc.signUp(email, password);
      busy(authForm, false);
      if (error) {
        if (error.code === 'weak_password') return fail('signin', 'הסיסמה חלשה מדי. נסו סיסמה ארוכה יותר.');
        if (error.code === 'user_already_exists' || error.code === 'email_exists') return fail('signin', 'כבר יש חשבון עם המייל הזה. עברו ל"כניסה", או אפסו את הסיסמה.');
        if (error.status === 429) return fail('signin', 'נשלחו יותר מדי מיילים. חכו כמה דקות ונסו שוב.');
        return fail('signin', 'ההרשמה לא הצליחה. נסו שוב בעוד רגע.');
      }
      if (data.session) return; // email confirmation off: already signed in
      // Supabase hides whether an email is registered: an existing address comes back with no identities.
      if (data.user && data.user.identities?.length === 0) return fail('signin', 'כבר יש חשבון עם המייל הזה. עברו ל"כניסה", או אפסו את הסיסמה.');
      sent(`שלחנו מייל ל־${email}. לחצו על הקישור שבו כדי לאשר את הכתובת, ותגיעו ישר לבחירת כינוי.`);
    });

    const sent = (text: string) => {
      const p = $('[data-sent-text]');
      p.textContent = text;
      show('sent');
    };

    // ---------- forgot / new password ----------
    $('[data-forgot]').addEventListener('click', () => {
      $<HTMLInputElement>('#acc-forgot-email').value = $<HTMLInputElement>('#acc-email').value;
      fail('forgot', '');
      show('forgot');
    });
    const forgotForm = $<HTMLFormElement>('[data-forgot-form]');
    forgotForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = $<HTMLInputElement>('#acc-forgot-email').value.trim();
      if (!validEmail(email)) return fail('forgot', 'הכתובת לא נראית תקינה. בדקו אותה ונסו שוב.');
      busy(forgotForm, true);
      const { error } = await acc.sendPasswordReset(email);
      busy(forgotForm, false);
      if (error) return fail('forgot', error.status === 429 ? 'נשלחו יותר מדי מיילים. חכו כמה דקות ונסו שוב.' : 'השליחה לא הצליחה. נסו שוב בעוד רגע.');
      sent(`אם יש חשבון עם ${email}, שלחנו אליו קישור לבחירת סיסמה חדשה.`);
    });
    root.querySelectorAll('[data-back]').forEach((b) => b.addEventListener('click', () => { setMode('signin'); show('signin'); }));

    const askNewPassword = (fromRecovery: boolean) => {
      $<HTMLInputElement>('#acc-newpass').value = '';
      $('[data-newpass-cancel]').hidden = fromRecovery;
      fail('newpass', '');
      show('newpass');
    };
    const newpassForm = $<HTMLFormElement>('[data-newpass-form]');
    newpassForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const password = $<HTMLInputElement>('#acc-newpass').value;
      if (password.length < 8) return fail('newpass', 'הסיסמה צריכה לפחות 8 תווים.');
      busy(newpassForm, true);
      const { error } = await acc.setPassword(password);
      busy(newpassForm, false);
      if (error) {
        if (error.code === 'same_password') return fail('newpass', 'זו הסיסמה הנוכחית. בחרו סיסמה אחרת.');
        if (error.code === 'weak_password') return fail('newpass', 'הסיסמה חלשה מדי. נסו סיסמה ארוכה יותר.');
        return fail('newpass', 'השמירה לא הצליחה. נסו שוב, או בקשו קישור איפוס חדש.');
      }
      void route();
    });
    $('[data-newpass-cancel] button').addEventListener('click', () => show('home'));
    $('[data-changepass]').addEventListener('click', () => askNewPassword(false));

    // ---------- nickname ----------
    const nickForm = $<HTMLFormElement>('[data-nick-form]');
    nickForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const nickname = $<HTMLInputElement>('#acc-nick').value.trim();
      const { NICKNAME_RE } = await import('../lib/progress-sync');
      if (!NICKNAME_RE.test(nickname)) return fail('nickname', 'הכינוי צריך 3 עד 16 תווים: אותיות, ספרות, _ או -, בלי רווחים.');
      const session = await acc.getSession();
      if (!session) return show('signin');
      busy(nickForm, true);
      const res = await acc.saveNickname(session.user.id, nickname, !profile);
      busy(nickForm, false);
      if (res === 'taken') return fail('nickname', 'הכינוי הזה כבר תפוס. נסו אחר.');
      if (res === 'error') return fail('nickname', 'השמירה לא הצליחה. נסו שוב בעוד רגע.');
      void route();
    });
    $('[data-nick-cancel] button').addEventListener('click', () => show('home'));
    $('[data-rename]').addEventListener('click', () => askNickname(false));

    // ---------- sign out / delete ----------
    $('[data-signout]').addEventListener('click', async () => {
      await acc.signOut();
      show('signin');
    });
    const danger = $<HTMLElement>('.danger');
    $('[data-delete]').addEventListener('click', async () => {
      if (!confirm('למחוק את החשבון לצמיתות? אי אפשר לבטל את זה.')) return;
      busy(danger, true);
      const { error } = await acc.deleteAccount();
      busy(danger, false);
      if (error) return fail('home', 'המחיקה לא הצליחה. נסו שוב, או כתבו לנו באינסטגרם.');
      show('signin');
      fail('signin', 'החשבון נמחק.');
    });

    await route();
  }
</script>

<style>
  .page { padding-top: 36px; max-width: 560px; }
  section { display: flex; flex-direction: column; gap: 14px; }
  [hidden] { display: none !important; }
  h1 { margin: 6px 0 4px; }
  h2 { font-size: 24px; margin-top: 24px; }
  .lead { margin: 0; font-size: 18px; color: var(--ink-2); }
  section > p { margin: 0; }
  .form { display: flex; flex-direction: column; gap: 8px; }
  .form label { font-weight: 700; }
  .form input {
    min-height: 52px; padding: 0 14px; font: 18px/1.2 var(--f-body); color: var(--ink);
    background: var(--washi); border: 1.5px solid var(--ink); border-radius: 6px;
  }
  .form input:focus-visible { outline-offset: 0; }
  .form p { margin: 0; }
  .wide { justify-content: center; width: 100%; margin-top: 6px; }
  .tabs { align-self: flex-start; }
  .err { color: var(--seal); font-weight: 500; min-height: 1.5em; }
  .err:empty { min-height: 0; }
  .link { appearance: none; background: none; border: 0; padding: 0; font: inherit; color: var(--seal); text-decoration: underline; cursor: pointer; }
  .stats { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; margin: 0; }
  .stats div { border: 1px solid var(--rule); border-radius: 8px; padding: 12px 14px; background: var(--washi-2); }
  .stats dt { font-size: 14px; color: var(--muted); }
  .stats dd { margin: 2px 0 0; font: 700 26px/1.2 var(--f-display); font-variant-numeric: tabular-nums; }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .actions .btn { min-height: 48px; font-size: 16px; }
  .danger { border-top: 1px solid var(--rule); padding-top: 14px; margin-top: 10px; }
  .danger summary { cursor: pointer; color: var(--seal); font-weight: 700; }
  .danger p { margin: 10px 0; color: var(--ink-2); }
  .danger-btn { background: var(--seal); color: var(--on-seal); min-height: 48px; font-size: 16px; }
  .danger-btn:hover { background: var(--seal-hover); color: var(--on-seal); }
</style>
