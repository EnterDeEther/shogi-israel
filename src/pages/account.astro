  .course-card { border: 1px solid var(--rule); border-inline-start: 4px solid var(--seal); border-radius: 8px; padding: 14px 16px; background: var(--washi-2); display: flex; flex-direction: column; gap: 6px; }
  .course-card p { margin: 0; }
  .welcome { border: 1px solid var(--rule); border-radius: 8px; padding: 14px 16px; margin-top: 16px; background: var(--washi-2); }
  .welcome h2 { margin: 0 0 4px; }
  .welcome p { margin: 0; }
