---
// The font of the Hebrew letters on the pieces (Noto Serif Hebrew / Suez One / Secular One). One site-wide setting
// (html[data-hfont]), remembered on this device only; the listener is in Base.astro. Hidden while the pieces show
// English letters or kanji. Each button is written in its own font.
import { HEBREW_FONTS } from '../lib/piece-set';
---
<div class="seg hfont-switch" role="group" aria-label="גופן האותיות על הכלים">
  {HEBREW_FONTS.map((f) => (
    <button type="button" data-hfont-set={f.id} aria-pressed={String(f.id === 'noto')}>{f.label}</button>
  ))}
</div>
