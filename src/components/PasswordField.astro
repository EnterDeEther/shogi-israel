---
interface Props { id: string; autocomplete: 'current-password' | 'new-password'; describedby?: string }
const { id, autocomplete, describedby } = Astro.props;
---
<div class="pass-field">
  <input id={id} name="password" type="password" dir="ltr" autocomplete={autocomplete} minlength="8" maxlength="72" required
    aria-describedby={describedby} spellcheck="false" autocapitalize="off" />
  <button type="button" class="eye" data-eye aria-controls={id} aria-pressed="false" aria-label="הצגת הסיסמה" title="הצגת הסיסמה">
    <svg class="eye-open" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>
    <svg class="eye-shut" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3l18 18"/><path d="M10.6 5.1A10.4 10.4 0 0 1 12 5c6.4 0 10 7 10 7a17.6 17.6 0 0 1-3.2 4.1M6.6 6.6C3.8 8.4 2 12 2 12s3.6 7 10 7a9.8 9.8 0 0 0 5.4-1.6"/><path d="M9.9 9.9a3 3 0 0 0 4.2 4.2"/></svg>
  </button>
</div>

<style>
  .pass-field { position: relative; display: flex; }
  .pass-field input { flex: 1; min-width: 0; }
  .eye {
    position: absolute; top: 0; bottom: 0; right: 0; width: 52px; display: grid; place-items: center;
    appearance: none; background: none; border: 0; color: var(--ink-2); cursor: pointer; border-radius: 0 6px 6px 0;
  }
  .pass-field input { padding-right: 56px !important; padding-left: 14px !important; }
  .eye:hover { color: var(--ink); }
  .eye:focus-visible { outline: 2px solid var(--ink); outline-offset: -4px; }
  .eye .eye-shut, .eye[aria-pressed='true'] .eye-open { display: none; }
  .eye[aria-pressed='true'] .eye-shut { display: block; }
</style>
