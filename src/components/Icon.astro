---
// One icon from src/lib/icons.ts, in the text colour. Decorative: the link or button beside it carries the words.
import { ICONS, BRANDS, type IconName } from '../lib/icons';

interface Props { name: IconName; size?: number; class?: string }
const { name, size = 20, class: cls } = Astro.props;
const brand = name in BRANDS ? BRANDS[name as keyof typeof BRANDS] : null;
---
{brand
  ? <svg class:list={['icon', cls]} width={size} height={size} viewBox="0 0 256 256" fill="currentColor" aria-hidden="true" focusable="false"><path d={brand}></path></svg>
  : <svg class:list={['icon', cls]} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={ICONS[name as keyof typeof ICONS]} />}
