---
import { chessOf, hebrewOf, kanjiOf, letterOf, type PieceType } from '../lib/sfen';
import { BOARD_STORIES, HERO_ART, PHASES, SHOW_CAPS, STORY, allPieces, type StoryPiece } from '../lib/home-story';
import { FIRST_GAME } from '../lib/first-game';
import { pageExists, LISHOGI_TEAM } from '../lib/live';
import { FACEBOOK_GROUP_URL, INSTAGRAM_URL, WHATSAPP_URL } from '../lib/nav';
import Icon from './Icon.astro';

interface Props { first: string }
const { first } = Astro.props;
const hasTry = first === '/try/';
const hasPlay = pageExists('/play/');
const hasChess = pageExists('/chess/');
const hasCourse = pageExists('/course/');

const side = (g: 0 | 1) => (g ? 'gote' : 'sente') as 'sente' | 'gote';
const labels = (t: PieceType, g: 0 | 1, promoted: boolean) => {
  const p = { type: t, side: side(g), promoted };
  const chess = chessOf(p);
  const plain = chess.replace(/︎/g, '');
  return {
    h: hebrewOf(p), c: chess, l: letterOf(p), k: kanjiOf(p),
    cs: plain.length > 1 ? 'two' : /[♔-♟-]/.test(plain) ? 'sym' : '',
  };
};
const n3 = (v: number) => +v.toFixed(3);
const xy = (k: string, p: { x: number; y: number }) => `--${k}x:${n3(p.x)};--${k}y:${n3(p.y)}`;
const H = HERO_ART;
const heroPcs = [
  ...H.pcs.map((p) => ({ t: p.t, g: p.g, cls: '', style: xy('', p) })),
  ...H.held.map((p) => ({ t: p.t, g: 0 as const, cls: 'held', style: xy('', p) })),
  { t: H.took, g: 1 as const, cls: 'tk', style: [xy('', H.to), xy('a', H.aside), xy('h', H.home)].join(';') },
  { t: H.mover, g: 0 as const, cls: 'mv', style: [xy('', H.mid), xy('f', H.from), xy('t', H.to)].join(';') },
];
const finalOf = (key: 'a' | 'b') => {
  const steps = Object.values(BOARD_STORIES[key].steps);
  const last = steps[steps.length - 1];
  return { state: last, at: new Map(last.pcs.map((p) => [p.id, p])) };
};
const vars = (p: StoryPiece) => `--r:${p.r};--c:${p.c};--s:${p.s ?? (p.lift ? 1.18 : 1)}`;
const on = (v: unknown) => (v ? '' : undefined);
const boards = (['a', 'b'] as const).map((key) => {
  const { state, at } = finalOf(key);
  return { key, state, pieces: allPieces(key).map((p) => ({ ...p, now: at.get(p.id) ?? p })) };
});
const board = (key: 'a' | 'b') => boards.find((b) => b.key === key)!;
const tray = (key: 'a' | 'b') => (BOARD_STORIES[key].first.hand || Object.values(BOARD_STORIES[key].steps).some((st) => st.hand) ? 0.95 : 0);
const stageStyle = (key: 'a' | 'b') => `--tb:${tray(key)};--rows:${9 + tray(key)};aspect-ratio:9 / ${9 + tray(key)}`;
const pawn = '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 21.5L16.6 17.6L18 3H6L7.4 17.6Z" fill="currentColor" fill-opacity=".18" stroke="none"></path><path d="M12 21.5L16.6 17.6L18 3H6L7.4 17.6Z"></path><path d="M9.4 9.6l2.6 2.6 2.6-2.6"></path></svg>';
const arrow = '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"></path></svg>';
const down = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6"></path></svg>';
const crown = '<svg viewBox="0 0 20 12" aria-hidden="true"><path d="M1 3.2 5.6 7 10 .8 14.4 7 19 3.2 17.2 11.2H2.8Z" /></svg>';
---
{hasPlay && (
  <p class="know wrap" data-newcomer data-snap>
    <span>כבר ⟦יודע|יודעת⟧ לשחק שוגי?</span>
    <a href="/play/">⟦שחק|שחקי⟧ עכשיו<Fragment set:html={arrow} /></a>
  </p>
)}

<section class="hero wrap" data-newcomer data-snap aria-labelledby="hero-h">
  <div class="hero-text">
    <p class="eyebrow">הקהילה הישראלית של השוגי</p>
    <h1 id="hero-h">⟦ברוך הבא|ברוכה הבאה⟧ לשוגי ישראל</h1>
    <p class="lead">שוגי הוא השחמט של יפן. כאן לומדים אותו מאפס, בעברית ובחינם.</p>
    <div class="cta">
      <a class="btn" href={first} data-tour="try">
        <span data-hero-label>{hasTry ? '⟦צפה|צפי⟧ במשחק אחד, מהלך אחרי מהלך' : '⟦התחל|התחילי⟧ בחוקים הבסיסיים'}</span>
        <Fragment set:html={arrow} />
      </a>
    </div>
    <ul class="side-doors">
      {hasChess && <li><a href="/chess/" data-chess-door><Icon name="chess" size={22} /><span><b>⟦משחק|משחקת⟧ שחמט?</b><span>יש לך מסלול משלך</span></span></a></li>}
      <li><a href="/what-is-shogi/" data-faq-open><Icon name="question" size={22} /><span><b>שאלות נפוצות</b><span>לפני שמתחילים</span></span></a></li>
    </ul>
    <a class="cue" href="#story-1">או ⟦גלול|גללי⟧ למטה, ונכיר את המשחק בדקה<Fragment set:html={down} /></a>
  </div>
  <div class="hero-art" aria-hidden="true" data-hero-art>
    <span class="ha" style={`--w:${n3(H.w)};--h:${n3(H.h)}`}>
      <span class="ha-in">
        <span class="ha-board" style={`width:calc(${n3(H.bw)} * var(--q));height:calc(${n3(H.bh)} * var(--q));${xy('l', H.line)}`}>
          {H.hoshi.map((p) => <span class="hoshi" style={`left:calc(${n3(p.x)} * var(--q));top:calc(${n3(p.y)} * var(--q))`}></span>)}
        </span>
        <span class="ha-hand" style={`${xy('', H.hand)};width:calc(${n3(H.hand.w)} * var(--q));height:calc(${n3(H.hand.h)} * var(--q))`}></span>
        <span class="ha-hl from" style={xy('', H.from)}></span>
        <span class="ha-hl to" style={xy('', H.to)}></span>
        {heroPcs.map((p) => {
          const lb = labels(p.t, p.g, false);
          return (
            <span class:list={['pc', p.cls]} style={p.style} data-g={on(p.g)}>
              <span class="sh">
                <span class="lb">
                  <span class:list={['ph', { two: lb.h.length > 1, crown: p.t === 'K' }]} dir="rtl">{p.t === 'K' && <Fragment set:html={crown} />}<span>{lb.h}</span></span>
                  <span class:list={['pcs', lb.cs]} dir="rtl">{lb.c}</span>
                  <span class="pl">{lb.l}</span>
                  <span class="pk" lang="ja">{lb.k}</span>
                </span>
              </span>
            </span>
          );
        })}
      </span>
    </span>
  </div>
</section>

<script>
  const art = document.querySelector<HTMLElement>('[data-hero-art]');
  if (art) {
    let seen = !('IntersectionObserver' in window);
    const run = () => art.toggleAttribute('data-run', seen && !document.hidden);
    if (!seen) new IntersectionObserver(([en]) => { seen = en.isIntersecting; run(); }).observe(art);
    document.addEventListener('visibilitychange', run);
    run();
  }
</script>

{(['a', 'c', 'b'] as const).map((key, n) => (
  <section data-snap class="scene wrap" id={`story-${n + 1}`} data-newcomer aria-labelledby={`story-${key}-h`}>
    <div class="scene-head rv">
      <p class="kicker">{key === 'a' ? 'מה זה שוגי, בדקה' : key === 'c' ? 'קוראים את הכלים' : 'מה שמיוחד בשוגי'}</p>
      <h2 id={`story-${key}-h`}>{key === 'a' ? 'משחק הגנרלים' : key === 'c' ? 'לא צריך לדעת יפנית' : 'כלי שלכדת עובר לצד שלך'}</h2>
    </div>
    <div class="story" data-story={key}>
      <div class="stage-col" aria-hidden="true">
        {key === 'c' ? (
          <div class="show" data-show data-face="1">
            <span class="big"><span class="sh">
              <span class="lb" data-f="0"><span class="pk" lang="ja">{labels('K', 0, false).k}</span></span>
              <span class="lb" data-f="1"><span class="ph crown" dir="rtl"><Fragment set:html={crown} /><span>{labels('K', 0, false).h}</span></span></span>
              <span class="lb" data-f="2"><span class="pl">{labels('K', 0, false).l}</span></span>
              <span class="lb" data-f="3"><span class:list={['pcs', labels('K', 0, false).cs]} dir="rtl">{labels('K', 0, false).c}</span></span>
            </span></span>
            <span class="sets" dir="rtl"><span>יפנית</span><span>עברית</span><span>אנגלית</span><span>שחמט</span></span>
          </div>
        ) : (
          <div class="stage" data-stage data-zone={on(board(key).state.zone)} data-hand={on(board(key).state.hand)} style={stageStyle(key)} data-still>
            <span class="board"><span class="zone"></span><span class="hoshi" style="left:33.333%;top:33.333%"></span><span class="hoshi" style="left:66.667%;top:33.333%"></span><span class="hoshi" style="left:33.333%;top:66.667%"></span><span class="hoshi" style="left:66.667%;top:66.667%"></span></span>
            {tray(key) > 0 && <span class="tray bot"><span>ביד שלך</span></span>}
            <span class="layer">
              {board(key).pieces.map((p) => {
                const base = labels(p.t, p.g, false);
                const up = p.promotes ? labels(p.t, p.g, true) : null;
                return (
                  <span class="pc" data-id={p.id} style={vars(p.now)} data-g={on(p.now.g)} data-p={on(p.now.pr)} data-out={on(p.now.out)} data-lift={on(p.now.lift)}>
                    <span class="sh">
                      {[base, up].filter((l) => !!l).map((lb, i) => (
                        <span class:list={['lb', i ? 'up' : 'n']}>
                          <span class:list={['ph', { two: lb.h.length > 1, crown: p.t === 'K' }]} dir="rtl">{p.t === 'K' && <Fragment set:html={crown} />}<span>{lb.h}</span></span>
                          <span class:list={['pcs', lb.cs]} dir="rtl">{lb.c}</span>
                          <span class="pl">{lb.l}</span>
                          <span class="pk" lang="ja">{lb.k}</span>
                        </span>
                      ))}
                    </span>
                  </span>
                );
              })}
            </span>
          </div>
        )}
        <p class="cap" data-cap>{key === 'c' ? SHOW_CAPS.c1 : board(key).state.cap}</p>
      </div>
      <div class="steps">
        {STORY[key].map((s) => <div class="step" data-snap data-s={s.key}><p class="card" set:html={s.text} /></div>)}
      </div>
    </div>
  </section>
))}

<section data-snap class="scene wrap" data-newcomer aria-labelledby="story-phases-h">
  <div class="scene-head rv">
    <p class="kicker">איך נראה משחק</p>
    <h2 id="story-phases-h">כל משחק עובר שלושה שלבים</h2>
  </div>
  <ol class="phases">
    {PHASES.map((ph, i) => <li class="phase rv"><span class="n">{i + 1}</span><div><h3>{ph.h}</h3><p>{ph.p}</p></div></li>)}
  </ol>
  <p class="small"><a href="/learn/guide/#phases">הסבר על שלושת השלבים</a></p>
</section>

<section data-snap data-flow-end class="scene wrap" data-newcomer aria-labelledby="story-go-h">
  <div class="scene-head rv">
    <p class="kicker">ועכשיו, תורך</p>
    <h2 id="story-go-h">מאיפה ⟦תרצה|תרצי⟧ להתחיל?</h2>
  </div>
  <div class="choose">
    {hasTry && (
      <a class="pick main rv" href="/try/">
        <h3>⟦צפה|צפי⟧ במשחק אחד<Fragment set:html={arrow} /></h3>
        <p>משחק שלם של {FIRST_GAME.length} מהלכים. ⟦אתה לוחץ|את לוחצת⟧, ואנחנו מסבירים כל מהלך. בלי הרשמה, ושום דבר לא זז לבד.</p>
        <span class="go">הצעד הראשון</span>
      </a>
    )}
    {hasChess && (
      <a class="pick rv" href="/chess/">
        <h3>⟦משחק|משחקת⟧ שחמט?</h3>
        <p>דף שמראה מה כבר מוכר לך ומה חדש, ומסלול שמתחיל משם.</p>
        <span class="go">לשחקני שחמט ←</span>
      </a>
    )}
    {hasCourse && (
      <a class="pick rv" href="/course/">
        <h3>רוצה סדר לימוד?</h3>
        <p>מסלול לימוד אישי: עונים על שאלה אחת ומקבלים סדר ברור, מהחוקים ועד בעיות מט.</p>
        <span class="go">למסלול ←</span>
      </a>
    )}
  </div>
  <p class="rules-line small rv">⟦מעדיף|מעדיפה⟧ לקרוא? <a href="/rules/">שמונה שיעורים קצרים של חוקים בסיסיים</a></p>
  {hasPlay && (
    <div class="also rv">
      <b>רוצה להתחיל לשחק כבר?</b>
      <span class="also-go">
        <a href="/play/">⟦שחק|שחקי⟧ נגד המחשב<Fragment set:html={arrow} /></a>
        <a class="touch-only" href="/play/?vs=local">שני שחקנים על אותו המכשיר<Fragment set:html={arrow} /></a>
      </span>
    </div>
  )}
</section>

<section class="scene wrap after" data-newcomer aria-labelledby="story-us-h">
  <div class="comm rv">
    <h2 id="story-us-h">איזה כיף ⟦שאתה|שאת⟧ פה</h2>
    <p>אני דין, וזה פרויקט התשוקה שלי. גיליתי את השוגי דרך אנימה, והתחלתי ללמוד מסרטונים ביוטיוב. שיחקתי המון מול המחשב והפסדתי הרבה פעמים, עד שהבנתי: המחשב לא מחליף משחק מול אדם אחר. חיפשתי מקום בארץ שבו אוכל לשחק עם אחרים, לא מצאתי, אז החלטתי לבנות אותו.</p>
    <p>הקהילה קטנה, והיא גדלה כל יום. ⟦בוא תצטרף|בואי תצטרפי⟧ אליי, ונבנה ביחד תרבות שוגי בארץ :)</p>
    <ul class="chips">
      <li><a href={WHATSAPP_URL} rel="noopener"><Icon name="whatsapp-logo" />קהילת הוואטסאפ</a></li>
      <li><a href={FACEBOOK_GROUP_URL} rel="noopener"><Icon name="facebook-logo" />קבוצת הפייסבוק</a></li>
      <li><a href={INSTAGRAM_URL} rel="noopener"><Icon name="instagram-logo" />אינסטגרם</a></li>
      <li><a href={LISHOGI_TEAM} rel="noopener"><Icon name="online" />הקבוצה שלנו בליש׳וגי</a></li>
      <li><a href="/community/"><Icon name="group" />דף הקהילה</a></li>
    </ul>
  </div>
</section>

<div class="rail" data-rail data-newcomer aria-hidden="true"><span class="rail-fill"></span></div>
<button type="button" class="more" data-more data-newcomer aria-label="לגלילה למטה"><Fragment set:html={pawn} /></button>

<script>
  import { BOARD_STORIES, type BoardState } from '../lib/home-story';
  import { snapGate, snapStops } from '../lib/snap-gate';

  const wide = matchMedia('(min-width: 900px), (max-width: 899px) and (orientation: landscape) and (max-height: 520px)');
  const watch = (story: HTMLElement, show: (key: string, back: boolean) => void, reset: () => void) => {
    if (!('IntersectionObserver' in window)) return;
    const steps = [...story.querySelectorAll<HTMLElement>('[data-s]')];
    const keys = steps.map((s) => s.getAttribute('data-s') || '');
    const col = story.querySelector<HTMLElement>('.stage-col');
    let cur = -1;
    const go = (k: string) => {
      const i = keys.indexOf(k);
      if (i < 0 || i === cur) return;
      const back = i < cur;
      cur = i;
      show(k, back);
    };
    let io: IntersectionObserver | undefined;
    let line = 0;
    const start = () => {
      io?.disconnect();
      const top = col && !wide.matches ? parseFloat(getComputedStyle(col).top) + col.offsetHeight : 0;
      line = Math.round(wide.matches ? innerHeight / 2 : top + 60);
      const pad = parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0;
      story.style.setProperty('--snap-m', `${Math.max(0, Math.round(top - pad))}px`);
      story.style.setProperty('--col-b', `${Math.round(top)}px`);
      io = new IntersectionObserver((ents) => ents.forEach((en) => { if (en.isIntersecting) go(en.target.getAttribute('data-s') || ''); }), { rootMargin: `-${line}px 0px -${Math.max(0, innerHeight - line - 1)}px 0px` });
      steps.forEach((s) => io!.observe(s));
    };
    start();
    if (col) {
      new IntersectionObserver(([en]) => {
        if (en.intersectionRatio >= 0.85) { if (cur < 0) go(keys[Math.max(0, steps.findLastIndex((s) => s.getBoundingClientRect().top <= line))]); }
        else if (en.boundingClientRect.top > 0 && cur >= 0) { cur = -1; reset(); }
      }, { threshold: [0, 0.85] }).observe(col);
    }
    let t = 0;
    addEventListener('resize', () => { clearTimeout(t); t = window.setTimeout(start, 200); });
  };
  const below = (el: HTMLElement) => el.getBoundingClientRect().top > innerHeight;
  const BEAT = 650;
  const still = matchMedia('(prefers-reduced-motion: reduce)');
  const settle = (fn: () => void) => {
    let t = 0;
    const kick = () => { clearTimeout(t); t = window.setTimeout(done, 160); };
    const done = () => { removeEventListener('scroll', kick); t = window.setTimeout(fn, BEAT); };
    addEventListener('scroll', kick, { passive: true });
    kick();
    return () => { clearTimeout(t); removeEventListener('scroll', kick); };
  };

  document.querySelectorAll<HTMLElement>('[data-story="a"], [data-story="b"]').forEach((story) => {
    const key = story.dataset.story as 'a' | 'b';
    const stage = story.querySelector<HTMLElement>('[data-stage]');
    const cap = story.querySelector<HTMLElement>('[data-cap]');
    if (!stage || !cap) return;
    const els = new Map([...stage.querySelectorAll<HTMLElement>('[data-id]')].map((el) => [el.dataset.id!, el]));
    const apply = (st: BoardState) => {
      for (const p of st.pcs) {
        const el = els.get(p.id);
        if (!el) continue;
        el.style.setProperty('--r', String(p.r));
        el.style.setProperty('--c', String(p.c));
        el.style.setProperty('--s', String(p.s ?? (p.lift ? 1.18 : 1)));
        el.toggleAttribute('data-g', p.g === 1);
        el.toggleAttribute('data-p', !!p.pr);
        el.toggleAttribute('data-out', !!p.out);
        el.toggleAttribute('data-lift', !!p.lift);
      }
      cap.textContent = st.cap;
      stage.toggleAttribute('data-zone', !!st.zone);
      stage.toggleAttribute('data-hand', !!st.hand);
    };
    let stop = () => {};
    const play = (st: BoardState, back: boolean) => {
      stop();
      if (!st.pre || back || still.matches) { apply(st); return; }
      apply(st.pre);
      stop = settle(() => apply(st));
    };
    const first = BOARD_STORIES[key].first;
    if (below(story)) apply(first);
    requestAnimationFrame(() => requestAnimationFrame(() => stage.removeAttribute('data-still')));
    watch(story, (s, back) => { const st = BOARD_STORIES[key].steps[s]; if (st) play(st, back); }, () => { stop(); apply(first); });
  });

  document.querySelectorAll<HTMLElement>('[data-story="c"]').forEach((story) => {
    const show = story.querySelector<HTMLElement>('[data-show]');
    if (!show) return;
    const HOLD = 1800;
    let face = 1, want = false, seen = true, timer = 0;
    const put = (i: number) => { face = i % 4; show.dataset.face = String(face); };
    const halt = () => { clearTimeout(timer); timer = 0; };
    const live = () => want && seen && !document.hidden && !still.matches;
    const next = () => { timer = 0; if (!live()) return; if (!document.documentElement.classList.contains('tour-on')) put(face + 1); timer = window.setTimeout(next, HOLD); };
    const resume = () => { if (live() && !timer) timer = window.setTimeout(next, HOLD); else if (!live()) halt(); };
    let stop = () => {};
    const rest = () => { stop(); want = false; halt(); put(still.matches ? 1 : 0); };
    if (below(story) && !still.matches) put(0);
    watch(story, () => {
      stop();
      halt();
      if (still.matches) { put(1); return; }
      stop = settle(() => { want = true; next(); });
    }, rest);
    if ('IntersectionObserver' in window) new IntersectionObserver(([en]) => { seen = en.isIntersecting; resume(); }).observe(show);
    document.addEventListener('visibilitychange', resume);
    still.addEventListener('change', () => { if (still.matches) { halt(); put(1); } else resume(); });
  });

  const html = document.documentElement;
  const rail = document.querySelector<HTMLElement>('[data-rail]');
  const end = document.querySelector<HTMLElement>('[data-flow-end]');
  if (rail && end) {
    const fill = rail.querySelector<HTMLElement>('.rail-fill')!;
    const faq = document.getElementById('faq');
    let ys: number[] = [], dots: HTMLElement[] = [], frame = 0, tail = Infinity;
    const measure = () => {
      if (html.hasAttribute('data-learner')) return;
      const els = [...document.querySelectorAll<HTMLElement>('[data-snap]')].filter((el) => el.getClientRects().length && (el === end || !!(end.compareDocumentPosition(el) & Node.DOCUMENT_POSITION_PRECEDING)));
      ys = snapStops(els, { h: innerHeight, scrollY, pad: parseFloat(getComputedStyle(html).scrollPaddingTop) || 0, max: html.scrollHeight - innerHeight });
      if (ys.length < 2) return;
      tail = faq && faq.getClientRects().length ? Math.round(faq.getBoundingClientRect().top + scrollY - (parseFloat(getComputedStyle(html).scrollPaddingTop) || 0)) : Infinity;
      dots.forEach((d) => d.remove());
      dots = ys.map((_, i) => { const d = document.createElement('span'); d.className = 'rail-dot'; d.style.top = `${(i / (ys.length - 1)) * 100}%`; rail.append(d); return d; });
      paint();
    };
    const paint = () => {
      frame = 0;
      if (ys.length < 2) return;
      const n = ys.length - 1;
      let i = 0;
      while (i < n - 1 && scrollY >= ys[i + 1]) i++;
      const part = Math.min(1, Math.max(0, (scrollY - ys[i]) / (ys[i + 1] - ys[i] || 1)));
      const p = Math.min(1, (i + part) / n);
      fill.style.transform = `scaleY(${p})`;
      dots.forEach((d, k) => d.toggleAttribute('data-on', k / n <= p + 0.001));
      const inFlow = scrollY > 40 && scrollY < ys[n] + innerHeight * 0.6;
      if (inFlow !== rail.hasAttribute('data-on')) rail.toggleAttribute('data-on', inFlow);
      const story = scrollY < Math.min(tail, ys[n] + innerHeight * 3) - 8;
      if (story !== html.hasAttribute('data-in-flow')) html.toggleAttribute('data-in-flow', story);
    };
    addEventListener('scroll', () => { if (!frame) frame = requestAnimationFrame(paint); }, { passive: true });
    let rt = 0;
    addEventListener('resize', () => { clearTimeout(rt); rt = window.setTimeout(measure, 250); });
    addEventListener('load', measure);
    document.fonts?.ready.then(measure);
    measure();
  }
  snapGate('[data-snap]', () => !html.hasAttribute('data-learner') && !html.classList.contains('tour-on') && !document.querySelector('dialog[open]'));
</script>

<script>
  import { nextStop, snapStops } from '../lib/snap-gate';

  const hint = document.querySelector<HTMLButtonElement>('[data-more]');
  if (hint) {
    const html = document.documentElement;
    const wide = matchMedia('(min-width: 900px), (max-width: 899px) and (orientation: landscape) and (max-height: 520px)');
    const still = matchMedia('(prefers-reduced-motion: reduce)');
    const view = () => ({ h: innerHeight, scrollY, pad: parseFloat(getComputedStyle(html).scrollPaddingTop) || 0, max: html.scrollHeight - innerHeight });
    const open = new Set(['HTML', 'BODY', 'MAIN']);
    let at = -1, t = 0, done = false;
    const hide = () => { hint.removeAttribute('data-on'); at = -1; };
    const roomy = () => {
      const r = hint.getBoundingClientRect();
      const cx = r.left + r.width / 2;
      return [r.top - 14, r.top + r.height / 2, r.bottom].every((y) => [cx - 48, cx, cx + 48].every((x) => {
        const el = document.elementsFromPoint(x, y).find((n) => !hint.contains(n));
        return !el || open.has(el.tagName) || el.matches('.home, .scene, .story, .steps, .step');
      }));
    };
    const check = () => {
      if (done || wide.matches || html.hasAttribute('data-learner') || html.classList.contains('tour-on') || document.querySelector('dialog[open]')) { hide(); return; }
      const v = view();
      const here = (el: HTMLElement) => snapStops([el], v).some((y) => Math.abs(y - scrollY) <= 4);
      const end = document.querySelector<HTMLElement>('[data-flow-end]');
      if (end && here(end)) { done = true; hide(); return; }
      const card = [...document.querySelectorAll<HTMLElement>('.scene[data-snap]:not([data-flow-end]), .scene .step[data-snap]')].find(here);
      if (!card || !roomy()) { hide(); return; }
      at = scrollY;
      hint.setAttribute('data-on', '');
    };
    const later = () => { clearTimeout(t); t = window.setTimeout(check, 1000); };
    addEventListener('scroll', () => { if (at >= 0 && Math.abs(scrollY - at) > 8) hide(); later(); }, { passive: true });
    addEventListener('resize', later);
    addEventListener('load', later);
    later();
    hint.addEventListener('click', () => {
      const to = nextStop(snapStops(document.querySelectorAll<HTMLElement>('[data-snap]'), view()), scrollY, 1);
      hide();
      if (to !== undefined) scrollTo({ top: to, behavior: still.matches ? 'auto' : 'smooth' });
    });
  }
</script>

