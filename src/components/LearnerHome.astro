---
import { LEVELS, LEVEL_INFO } from '../lib/curriculum';
import { WEEK_LENGTH } from '../tsume/week';
import InfoTip from './InfoTip.astro';
import Icon from './Icon.astro';
import AfterCourse from './AfterCourse.astro';

interface Props { weekCount: number; accounts?: boolean }
const { weekCount, accounts = false } = Astro.props;
const WHATSAPP = 'https://chat.whatsapp.com/Hl05iCdO2OY1rJIETuAien';
---
<section class="me wrap" data-learner-only data-me data-week-count={weekCount} aria-labelledby="me-h">
  <div class="hello">
    <p class="eyebrow">⟦ברוך השב|ברוכה השבה⟧</p>
    <h1 id="me-h"><span data-me-hello>טוב לראות אותך שוב</span>.</h1>
    <p class="lead" data-me-lead>הנה הצעד הבא שלך.</p>
  </div>

  <div class="me-grid">
    <div class="me-main">
      <div class="next game" data-game hidden>
        <p class="next-where">משחק פתוח · <span data-game-what></span></p>
        <p class="next-title">המשחק שלך מחכה</p>
        <a class="btn next-btn" href="/play/" data-game-link><span>⟦המשך|המשיכי⟧ את המשחק</span></a>
      </div>

      <div class="next" data-next-card aria-labelledby="next-title">
        <p class="next-where" data-next-where>הצעד הבא במסלול</p>
        <p class="next-title" id="next-title" data-next-title>המסלול שלך</p>
        <p class="next-why" data-next-why></p>
        <div class="next-progress" data-next-progress hidden>
          <div class="bar" aria-hidden="true"><span></span></div>
          <span class="small"></span>
        </div>
        <div class="next-actions">
          <a class="btn next-btn" href="/course/" data-next-link data-tour="next"><span data-next-cta>למסלול</span></a>
          <span class="next-share" data-next-share hidden></span>
        </div>
      </div>
    </div>

    <div class="me-side">
      <ul class="tiles" aria-label="להיום">
        <li class="tile">
          <h2 class="tile-h"><Icon name="play" size={20} />⟦שחק|שחקי⟧ עכשיו</h2>
          <p data-play-text>עשר רמות, ממתחילים ועד מתקדמים. רמה 1 סלחנית, והמטרה רק לסיים משחק שלם.</p>
          <a class="tile-link" href="/play/" data-play-link><span data-play-cta>לשחק</span> ←</a>
        </li>
        <li class="tile">
          <h2 class="tile-h"><Icon name="king" size={20} />בעיית השבוע</h2>
          <p data-week-text>בעיית מט ב־{WEEK_LENGTH} מהלכים<InfoTip id="mate" />, אותה בעיה לכולם. בעיה חדשה בכל יום ראשון.</p>
          <a class="tile-link" href="/tsume/week/" data-week-link><span data-week-cta>לפתור</span> ←</a>
        </li>
        <li class="tile">
          <h2 class="tile-h"><Icon name="question" size={20} />שאלות נפוצות</h2>
          <p>תשובות קצרות: חוקים, ההבדלים משחמט, איפה משחקים ועם מי.</p>
          <a class="tile-link" href="/what-is-shogi/" data-faq-open>לשאלות ←</a>
        </li>
        <li class="tile touch-only">
          <h2 class="tile-h"><Icon name="two-players" size={20} />חבר לידך?</h2>
          <p>שני שחקנים על אותו מכשיר, כל אחד מקבל צד של הלוח.</p>
          <a class="tile-link" href="/play/?vs=local">לשחק ביחד ←</a>
        </li>
      </ul>

      <aside class="rank" aria-labelledby="rank-h" data-tour="rank">
        <span class="rank-kanji" lang="ja" aria-hidden="true" data-rank-kanji>十五級</span>
        <div class="rank-body">
          <p class="rank-row"><span class="rank-name" data-rank-name>15 קיו</span><span class="rank-head" id="rank-h">דרגת הלימוד שלך · במסלול</span><InfoTip id="rank" /></p>
          <div class="bar" aria-hidden="true"><span data-rank-bar></span></div>
          <p class="small rank-text"><span data-rank-points>0 נקודות</span> · <span data-rank-text>נקודות נצברות פעם אחת על כל שיעור, בעיה או משחק.</span></p>
          <p class="small rank-guest" data-signed-out-only>{accounts ? 'הנקודות נשמרות רק בדפדפן הזה, עד שיש חשבון.' : 'הנקודות נשמרות בדפדפן הזה.'}</p>
          <p class="small"><a href="/ranks/#site">דרגה של לימוד באתר, לא דרגה רשמית</a></p>
        </div>
      </aside>
    </div>
  </div>

  {accounts && (
    <div class="invite" data-signed-out-only data-invite aria-labelledby="invite-h">
      <p class="invite-head" id="invite-h"><span data-invite-head>כרגע ההתקדמות שלך שמורה רק בדפדפן הזה.</span> עם חשבון בחינם:</p>
      <ul class="invite-list">
        <li>ההתקדמות נשמרת בכל מכשיר, בטלפון ובמחשב.</li>
        <li data-invite-place>מסלול אישי: עונה על שתי שאלות קצרות ⟦ומקבל|ומקבלת⟧ נקודת התחלה שמתאימה לך.</li>
        <li>הנקודות ודרגת הלימוד שלך נשמרות בחשבון ולא הולכות לאיבוד.</li>
        <li>אם ⟦תרצה|תרצי⟧, בעיית השבוע במייל, פעם בשבוע לכל היותר.</li>
      </ul>
      <p class="invite-note">מה שכבר עשית כאן נכנס לחשבון ונספר. אפשר גם להמשיך בלי חשבון.</p>
      <div class="invite-actions">
        <a class="btn invite-btn" href="/account/?mode=signup"><span>⟦פתח|פתחי⟧ חשבון בחינם</span></a>
        <a class="invite-link" href="/account/?mode=signin">כבר יש לך חשבון? כניסה</a>
        <button type="button" class="invite-link invite-later" data-invite-later>לא עכשיו</button>
      </div>
    </div>
  )}

  <section class="block-sm" data-after-sec hidden aria-labelledby="after-h">
    <div class="head-row">
      <h2 id="after-h">מה עכשיו?</h2>
    </div>
    <AfterCourse />
  </section>

  <section class="block-sm" aria-labelledby="path-h">
    <div class="head-row">
      <h2 id="path-h">המסלול שלך</h2>
      <a class="small" href="/course/">למסלול המלא</a>
    </div>
    <ol class="units">
      {LEVELS.map((l, i) => (
        <li>
          <a class="unit" href={`/course/#${l}`} data-level={l}>
            <span class="unit-tag small">רמה {i + 1} מתוך {LEVELS.length}</span>
            <strong class="unit-title">{LEVEL_INFO[l].title}</strong>
            <span class="unit-goal small">{LEVEL_INFO[l].goal}</span>
            <span class="unit-count small" data-unit-count></span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="part" aria-labelledby="part-h">
    <h2 id="part-h">⟦אתה|את⟧ חלק מזה</h2>
    <p>מצאת שיעור מבלבל, או מונח שאפשר לומר טוב יותר בעברית? <a href="/about/#contact">⟦כתוב|כתבי⟧ לי</a>, ואני אתקן. שאלות, עדכונים ומי רוצה לשחק: <a href={WHATSAPP} rel="noopener">הקהילה בוואטסאפ</a>.</p>
  </section>
</section>

<script>
  import { accountsEnabled, hasStoredSession } from '../lib/account-config';
  import { hasAnyProgress, KIND_LABEL, LEVELS, levelInfoFor, nextStep, pathProgress, stepCount, stepHref, unitProgress, unitsOf, whereLabel } from '../lib/curriculum';
  import { LEVEL_COUNTS } from '../lib/level-counts';
  import { readLocal } from '../lib/progress-local';
  import { rankFor, xpBreakdown } from '../lib/xp';
  import { weekIndex, weekPuzzle, weekStreak, weeksHe, WEEK_LENGTH } from '../tsume/week';
  import { tipEl } from '../lib/info-tip-dom';
  import { hasActivity } from '../lib/visitor';
  import { gameInProgress, openGameText } from '../play/record';
  import { COMMUNITY_URL, nextLevel } from '../lib/after-course';
  import { shareButton } from '../lib/share-card';

  const root = document.querySelector<HTMLElement>('[data-me]');
  const html = document.documentElement;
  const signedIn = () => accountsEnabled && hasStoredSession();
  const $ = <T extends HTMLElement = HTMLElement>(sel: string, el: ParentNode = root!) => el.querySelector<T>(sel)!;
  const text = (sel: string, t: string) => { $(sel).textContent = t; };
  const pct = (a: number, b: number) => `${b ? Math.round((100 * a) / b) : 0}%`;

  function render() {
    if (!root) return;
    const p = readLocal();
    if (!signedIn() && !hasActivity(localStorage)) { html.removeAttribute('data-learner'); return; }
    html.setAttribute('data-learner', '');

    const placed = !!p.course.route;
    const next = signedIn() && !placed ? undefined : nextStep(p, LEVEL_COUNTS);
    const link = $<HTMLAnchorElement>('[data-next-link]');
    const prog = $('[data-next-progress]');
    prog.hidden = true;
    link.removeAttribute('target');
    link.removeAttribute('rel');
    if (signedIn() && !placed) {
      text('[data-next-where]', 'מסלול לימוד אישי');
      text('[data-next-title]', 'מאיפה מתחילים?');
      text('[data-next-why]', '⟦ענה|עני⟧ על שתי שאלות קצרות, ⟦ותקבל|ותקבלי⟧ נקודת התחלה: מתחילים, בינוניים או מתקדמים.');
      text('[data-next-cta]', 'לבחירת נקודת ההתחלה');
      link.href = '/course/';
    } else if (!next) {
      text('[data-next-where]', 'מסלול לימוד אישי');
      text('[data-next-title]', 'סיימת את כל המסלול!');
      text('[data-next-why]', 'עברת את שלוש הרמות, מהמהלך הראשון ועד מט. מכאן הכי כיף לשחק מול אנשים: בקהילה בוואטסאפ מוצאים יריבים.');
      text('[data-next-cta]', '⟦מצא|מצאי⟧ יריב בקהילה');
      link.href = COMMUNITY_URL;
      link.target = '_blank';
      link.rel = 'noopener';
    } else {
      const { unit, step } = next;
      text('[data-next-where]', `הצעד הבא במסלול · ${whereLabel(unit)} · ${KIND_LABEL[step.kind]}, ${step.minutes} דק׳`);
      text('[data-next-title]', step.title);
      text('[data-next-why]', step.why);
      const started = hasAnyProgress(p);
      text('[data-next-cta]', started ? '⟦המשך|המשיכי⟧ מאיפה שעצרת' : '⟦התחל|התחילי⟧');
      link.href = stepHref(step, p, LEVEL_COUNTS);
      const inStep = stepCount(step, p, LEVEL_COUNTS);
      const up = inStep ?? unitProgress(unit, p, LEVEL_COUNTS);
      if (up.of > 0) {
        prog.hidden = false;
        $('.bar span', prog).style.width = pct(up.done, up.of);
        $('.small', prog).textContent = inStep ? `${up.done} מתוך ${up.of} בצעד הזה` : `${up.done} מתוך ${up.of} צעדים ב${unit.title}`;
      }
    }
    const done = !next && !(signedIn() && !placed);
    root.toggleAttribute('data-done', done);
    $('[data-after-sec]').hidden = !done;
    const share = $('[data-next-share]');
    share.hidden = !done;
    const r0 = rankFor(xpBreakdown(p, LEVEL_COUNTS).total).rank;
    if (done && !share.firstChild) share.append(shareButton({ title: 'סיימתי את מסלול הלימוד של שוגי', sub: `שלוש רמות, מהמהלך הראשון ועד מט · ${r0.name}`, kanji: r0.kanji, path: '/course/' }, 'shogi-israel-course.png', 'btn next-share-btn'));
    if (done) {
      const lv = nextLevel(p.course.won);
      $<HTMLAnchorElement>('[data-after-sec] [data-after-link="play"]').href = `/play/?level=${lv}`;
      text('[data-after-sec] [data-after-title="play"]', `המחשב, מרמה ${lv} והלאה`);
    }
    const head = root.querySelector('[data-invite-head]');
    if (head) head.textContent = done ? 'סיימת את כל המסלול, וההישג שמור רק בדפדפן הזה.' : 'כרגע ההתקדמות שלך שמורה רק בדפדפן הזה.';
    const place = root.querySelector<HTMLElement>('[data-invite-place]');
    if (place) place.hidden = done;
    const game = gameInProgress();
    const gameBox = $('[data-game]');
    gameBox.hidden = !game;
    root.toggleAttribute('data-has-game', !!game);
    if (game) text('[data-game-what]', openGameText(game));
    text('[data-me-lead]', game ? 'המשחק שלך מחכה, והצעד הבא במסלול מתחתיו.' : next || (signedIn() && !placed) ? 'הנה הצעד הבא שלך.' : 'עשית את כל הדרך. כל הכבוד.');

    const xp = xpBreakdown(p, LEVEL_COUNTS).total;
    const r = rankFor(xp);
    text('[data-rank-kanji]', r.rank.kanji);
    text('[data-rank-name]', r.rank.name);
    text('[data-rank-points]', `${xp.toLocaleString('he-IL')} נקודות`);
    $('[data-rank-bar]').style.width = r.next ? pct(r.into, r.span) : '100%';
    text('[data-rank-text]', r.next
      ? `עוד ${(r.next.min - xp).toLocaleString('he-IL')} נקודות ל־${r.next.name}. נקודות נצברות פעם אחת על כל שיעור, בעיה או משחק.`
      : 'הגעת לדרגה הגבוהה ביותר במסלול.');

    const path = pathProgress(p, LEVEL_COUNTS);
    for (const l of LEVELS) {
      const a = $<HTMLAnchorElement>(`[data-level="${l}"]`);
      const up = unitsOf(l, p.course.route).map((u) => unitProgress(u, p, LEVEL_COUNTS)).reduce((x, y) => ({ done: x.done + y.done, of: x.of + y.of }), { done: 0, of: 0 });
      $('[data-unit-count]', a).textContent = up.of === 0 && p.course.route ? 'כבר מוכר' : up.done === up.of && up.of > 0 ? 'הושלם ✓' : up.done > 0 ? `${up.done} מתוך ${up.of} צעדים` : '';
      a.toggleAttribute('data-current', !!next && next.unit.level === l);
      $('.unit-goal', a).textContent = levelInfoFor(p.course.route)[l].goal;
    }
    root.dataset.pathDone = String(path.done);

    const weekCount = Number(root.dataset.weekCount) || 0;
    if (weekCount > 0) {
      const week = weekIndex();
      const solved = p.tsume[String(WEEK_LENGTH)] ?? [];
      const id = weekPuzzle(week, weekCount);
      const streak = weekStreak(solved, weekCount, week);
      const streakText = streak > 1 ? ` רצף של ${weeksHe(streak)}.` : '';
      if (solved.includes(id)) {
        text('[data-week-text]', `פתרת את בעיית השבוע ✓${streakText} בעיה חדשה מחכה ביום ראשון, ועד אז יש עוד אלפי בעיות.`);
        text('[data-week-cta]', 'לעוד בעיות מט');
        $<HTMLAnchorElement>('[data-week-link]').href = '/tsume/';
      } else {
        $('[data-week-text]').replaceChildren(`בעיית מט ב־${WEEK_LENGTH} מהלכים`, tipEl('mate'), `, אותה בעיה לכולם. בעיה חדשה בכל יום ראשון.${streakText}`);
        text('[data-week-cta]', streak > 0 ? 'לשמור על הרצף' : 'לפתור');
        $<HTMLAnchorElement>('[data-week-link]').href = '/tsume/week/';
      }
    }

    const { played, won } = p.course;
    let level = 1;
    if (won > 0) {
      level = Math.min(10, won + 1);
      text('[data-play-text]', won >= 10 ? 'ניצחת את המחשב ברמה הגבוהה ביותר. ⟦נסה|נסי⟧ לנצח שוב, הפעם עם צבע אחר.' : `ניצחת את המחשב ברמה ${won}. ⟦מוכן|מוכנה⟧ לנסות את רמה ${level}?`);
    } else if (played > 0) {
      level = played;
      text('[data-play-text]', `כבר שיחקת ברמה ${played}. הפעם ⟦נסה|נסי⟧ לנצח בה: קודם מבצר, אחר כך התקפה.`);
    }
    $<HTMLAnchorElement>('[data-play-link]').href = `/play/?level=${level}`;
    text('[data-play-cta]', `לשחק ברמה ${level}`);
  }

  async function hello() {
    if (!signedIn()) return;
    try {
      const { getSession, getProfile } = await import('../lib/account');
      const s = await getSession();
      const prof = s && (await getProfile(s.user.id));
      if (!prof?.nickname) return;
      const el = $('[data-me-hello]');
      el.textContent = 'שלום, ';
      const b = document.createElement('bdi');
      b.textContent = prof.nickname;
      el.append(b);
    } catch { }
  }

  const LATER_KEY = 'shogi-il.invite-later';
  const LATER_MS = 14 * 24 * 60 * 60 * 1000;
  function invite() {
    const box = root?.querySelector<HTMLElement>('[data-invite]');
    if (!box) return;
    let until = 0;
    try { until = Number(localStorage.getItem(LATER_KEY)) || 0; } catch { }
    box.hidden = until > Date.now();
    box.querySelector('[data-invite-later]')?.addEventListener('click', () => {
      try { localStorage.setItem(LATER_KEY, String(Date.now() + LATER_MS)); } catch { }
      box.hidden = true;
    });
  }

  render();
  invite();
  void hello();
  document.addEventListener('progress-synced', render);
  document.addEventListener('shogi-il:open-game-synced', render);
</script>

<style>
  .me { padding-top: 22px; }
  .hello { display: grid; gap: 6px; }
  .me h1 { font-size: clamp(34px, 7vw, 52px); line-height: 1.1; }
  .me .lead { margin: 0; font-size: 18px; line-height: 1.6; color: var(--ink-2); }
  .me-grid { display: grid; gap: 14px; margin-top: 18px; }
  .me-main, .me-side { display: flex; flex-direction: column; gap: 12px; min-width: 0; }

  .bar { height: 8px; border-radius: 999px; background: var(--rule); overflow: hidden; }
  .bar span { display: block; height: 100%; width: 0; background: var(--seal); border-radius: inherit; transition: width .3s; }

  .next { background: var(--ink); color: var(--washi); border-radius: 16px; padding: 22px 20px; display: flex; flex-direction: column; gap: 10px; box-shadow: var(--shadow-2); }
  .next[hidden] { display: none; }
  .next p { margin: 0; }
  .next-where { font-size: 14px; font-weight: 700; line-height: 1.5; opacity: .8; }
  .next-title { font-family: var(--f-display); font-size: clamp(26px, 5vw, 32px); font-weight: 800; line-height: 1.15; }
  .next-why { font-size: 16.5px; line-height: 1.6; opacity: .88; max-width: 36em; }
  .next-why:empty { display: none; }
  .next-progress { display: flex; align-items: center; gap: 12px; }
  .next-progress[hidden], .next-share[hidden], [data-after-sec][hidden], .invite-list li[hidden] { display: none; }
  .next-actions { display: flex; flex-direction: column; gap: 8px; margin-top: 4px; }
  .next-share :global(.next-share-btn) { width: 100%; justify-content: center; background: transparent; color: var(--washi); border-color: color-mix(in srgb, var(--washi) 65%, transparent); }
  .next-progress .bar { flex: 1; max-width: 280px; background: color-mix(in srgb, var(--washi) 25%, transparent); }
  .next-btn { align-self: stretch; background: var(--washi); color: var(--ink); border-color: var(--washi); }
  .next-btn:hover { background: var(--kaya); color: #1C1B19; border-color: var(--kaya); }
  .me[data-has-game] [data-next-card] { background: var(--surface); color: var(--ink); box-shadow: var(--shadow-1); border: 1px solid var(--rule); padding: 16px 18px; }
  .me[data-has-game] [data-next-card] .next-title { font-size: 22px; }
  .me[data-has-game] [data-next-card] .next-progress .bar { background: var(--rule); }
  .me[data-has-game] [data-next-card] .next-btn { background: transparent; color: var(--ink); border-color: var(--rule); }
  .me[data-has-game] [data-next-card] .next-share :global(.next-share-btn) { color: var(--ink); border-color: var(--rule); }

  .tiles { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .tile { background: var(--surface); border: 1px solid var(--rule); border-radius: 14px; padding: 14px 16px 6px; display: flex; flex-direction: column; gap: 4px; box-shadow: var(--shadow-1); }
  .tile-h { display: flex; align-items: center; gap: 8px; margin: 0; font-size: 19px; }
  .tile-h :global(.icon) { color: var(--seal); flex: none; }
  .tile p { margin: 0; color: var(--ink-2); line-height: 1.55; font-size: 15.5px; flex: 1; }
  .tile-link { display: inline-flex; align-items: center; min-height: 44px; font-weight: 700; color: var(--seal); text-decoration: none; align-self: flex-start; }
  .tile-link:hover { text-decoration: underline; }

