---
// A small card at the bottom of some pages that offers the site as an app on the home screen (src/lib/install.ts).
// Phones and tablets only, never on the first page someone opens, never inside the app, and "לא עכשיו" puts it
// away for three weeks. Android installs from here at once; on an iPhone the button leads to the short guide on
// /app/, because the home-screen icon opens the page it was added from.
// Only on pages without a board in the way of the thumb (lessons, games and puzzles keep the screen to themselves).
import Icon from './Icon.astro';

const PAGES = ['/', '/course/', '/learn/', '/tsume/', '/rules/', '/what-is-shogi/', '/chess/', '/community/', '/about/', '/ranks/', '/history/', '/account/'];
const show = PAGES.includes(Astro.url.pathname);
---
{show && (
  <aside class="install-offer" data-install-offer hidden aria-labelledby="install-offer-h">
    <img src="/app-icon-192.png" width="48" height="48" alt="" />
    <div class="txt">
      <p class="h" id="install-offer-h">שוגי ישראל במסך הבית</p>
      <p class="sub">משחק נגד המחשב והמסלול שלך בלחיצה אחת, כמו אפליקציה.</p>
    </div>
    <div class="act">
      <button type="button" class="btn go" data-install-go><Icon name="add-home" size={18} /><span>התקנה</span></button>
      <a class="btn go" href="/app/#install" data-install-how hidden><Icon name="add-home" size={18} /><span>איך מתקינים?</span></a>
    </div>
    <button type="button" class="x" data-install-later aria-label="לא עכשיו">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
    </button>
  </aside>
)}

<script>
  import { installWay, later, offerWanted, onInstallChange, promptInstall } from '../lib/install';

  const box = document.querySelector<HTMLElement>('[data-install-offer]');
  if (box) {
    const go = box.querySelector<HTMLButtonElement>('[data-install-go]')!;
    const how = box.querySelector<HTMLAnchorElement>('[data-install-how]')!;
    const hide = () => { box.classList.add('leaving'); setTimeout(() => { box.hidden = true; box.classList.remove('leaving'); }, 180); };
    const update = () => {
      if (!offerWanted()) { if (!box.hidden) hide(); return; }
      const prompt = installWay() === 'prompt';
      go.hidden = !prompt;
      how.hidden = prompt;
      box.hidden = false;
    };
    go.addEventListener('click', async () => { if (await promptInstall()) hide(); });
    how.addEventListener('click', () => later()); // they are on their way to the guide; no need to offer again soon
    box.querySelector('[data-install-later]')!.addEventListener('click', () => { later(); hide(); });
    onInstallChange(update);
    // a moment after the page settles, so it never competes with the page's own first words
    setTimeout(update, 2500);
  }
</script>

<style>
  .install-offer {
    position: fixed; z-index: 35; inset-inline: 12px; bottom: calc(12px + env(safe-area-inset-bottom, 0px));
    display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 10px 12px;
    max-width: 520px; margin-inline: auto; padding: 12px; padding-inline-end: 44px;
    background: var(--glass-hi); -webkit-backdrop-filter: blur(24px) saturate(1.6); backdrop-filter: blur(24px) saturate(1.6);
    border: 1px solid var(--glass-edge); border-radius: 18px; box-shadow: var(--shadow-glass);
    animation: drop-up .32s var(--ease-out);
  }
  .install-offer[hidden] { display: none; }
  .install-offer.leaving { opacity: 0; transform: translateY(12px); transition: opacity .18s ease, transform .18s ease; }
  .install-offer img { width: 48px; height: 48px; border-radius: 12px; }
  .txt p { margin: 0; }
  .h { font-weight: 700; font-size: 16px; line-height: 1.3; }
  .sub { font-size: 14px; line-height: 1.4; color: var(--muted); }
  .act { grid-column: 1 / -1; display: flex; }
  .go { flex: 1; justify-content: center; min-height: 44px; font-size: 16px; gap: 8px; }
  .go[hidden] { display: none; }
  .x {
    position: absolute; top: 6px; inset-inline-end: 6px; width: 36px; height: 36px; border: 0; border-radius: 999px;
    background: transparent; color: var(--muted); display: grid; place-items: center; cursor: pointer;
  }
  .x:hover { background: color-mix(in srgb, var(--ink) 7%, transparent); }
  @media (min-width: 560px) {
    .act { grid-column: auto; }
  }
  @keyframes drop-up { from { opacity: 0; transform: translateY(16px); } }
  @media (prefers-reduced-motion: reduce) {
    .install-offer { animation: fade-in .15s ease-out; }
    .install-offer.leaving { transform: none; }
  }
  @media (prefers-reduced-transparency: reduce) {
    .install-offer { -webkit-backdrop-filter: none; backdrop-filter: none; background: var(--surface); }
  }
  :global(html.tour-on) .install-offer { display: none; }
</style>
