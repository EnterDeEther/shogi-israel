---
interface Props { title?: string }
const { title } = Astro.props;
---
<aside class="note">
  {title && <p class="note-title">{title}</p>}
  <div class="note-body"><slot /></div>
</aside>

<style>
  .note { margin: 24px 0; padding: 16px 18px; background: var(--washi-2); border-radius: 6px; }
  .note-title { margin: 0 0 4px; font-size: 13px; font-weight: 700; color: var(--seal); letter-spacing: 0.3px; }
  .note-body { font-size: 16px; line-height: 1.7; color: var(--ink-2); }
  .note-body :global(p) { margin: 0; }
</style>
