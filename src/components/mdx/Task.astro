---
// One action under a board. `answer`:
//   "55" or "53,55"   → tap one of these squares on the board above
//   "rank:1-3"        → tap any square in those ranks
//   "sente" | "gote"  → a two-button question (פותח / משיב)
//   (none)            → an instruction only, nothing to check
// `hint`: shown under the board after a second wrong tap.
// `why`: shown with a correct answer, to say why it is right.
// Board tasks write their feedback here and under the board; Step.astro shows whichever sits next to the board.
interface Props { answer?: string; hint?: string; why?: string }
const { answer, hint, why } = Astro.props;
const choice = answer === 'sente' || answer === 'gote';
---
<div class="task" data-task data-answer={answer} data-hint={hint} data-why={why} data-kind={answer ? (choice ? 'choice' : 'board') : 'none'}>
  <p class="task-label">{answer ? 'נסו בעצמכם' : 'לפני שממשיכים'}</p>
  <div class="task-body"><slot /></div>
  {choice && (
    <div class="choices" role="group" aria-label="בחרו תשובה">
      <button type="button" class="btn btn-ghost" data-choice="sente">הפותח</button>
      <button type="button" class="btn btn-ghost" data-choice="gote">המשיב</button>
    </div>
  )}
  {answer && <p class="task-fb" role="status" aria-live="polite"></p>}
</div>

<style>
  .task { margin: 20px 0 8px; padding: 16px 18px; border: 1.5px solid var(--ink); border-radius: 6px; }
  .task-label { margin: 0 0 4px; font-size: 13px; font-weight: 700; color: var(--seal); letter-spacing: 0.3px; }
  .task-body { font-size: 17px; line-height: 1.65; }
  .task-body :global(p) { margin: 0; }
  .choices { display: flex; gap: 10px; margin-top: 12px; flex-wrap: wrap; }
  .choices .btn { min-height: 48px; justify-content: center; min-width: 120px; }
  .choices .btn[aria-pressed="true"] { background: var(--ink); color: var(--washi); }
  .task-fb { margin: 10px 0 0; min-height: 1.6em; font-weight: 700; }
  .task-fb:global(.is-ok) { color: var(--ok-text); }
  .task-fb:global(.is-no) { color: var(--no-text); }
  .task-fb:empty { margin: 0; min-height: 0; }
  :global(.task.done) { border-color: var(--ok-text); }
  :global(.task.done) .task-label { color: var(--ok-text); }
</style>
