---
import Icon from './Icon.astro';
interface Props { class?: string }
const { class: cls } = Astro.props;
---
<section class:list={['news', cls]} data-news data-news-bar hidden aria-label="עדכונים באתר">
  <template data-news-kit>
    <span data-kind-icon="new"><Icon name="news-new" size={15} /></span>
    <span data-kind-icon="content"><Icon name="news-content" size={15} /></span>
    <span data-kind-icon="important"><Icon name="news-important" size={15} /></span>
    <span data-kind-icon="changed"><Icon name="news-changed" size={15} /></span>
    <span data-kind-icon="moved"><Icon name="news-moved" size={15} /></span>
    <span data-kind-icon="fixed"><Icon name="news-fixed" size={15} /></span>
    <svg data-news-arrow viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"></path></svg>
    <span data-news-pause><svg class="i-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6.5" y="5" width="3.6" height="14" rx="1.2"></rect><rect x="13.9" y="5" width="3.6" height="14" rx="1.2"></rect></svg><svg class="i-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17 5.8v12.4a1 1 0 0 1-1.5.9L6.2 13a1.2 1.2 0 0 1 0-2l9.3-6.1a1 1 0 0 1 1.5.9z"></path></svg></span>
    <svg data-news-close viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
  </template>
</section>

<script>
  import { startNews } from '../lib/news-ui';
  document.querySelectorAll<HTMLElement>('[data-news]').forEach(startNews);
</script>

<style is:global>
.news { container-type: inline-size; container-name: news; margin-block: 14px 4px; }
.news[hidden] { display: none; }
.news-card {
  position: relative; display: grid; grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: "stage ctrl" "segs segs";
  align-items: center; gap: 4px 10px; padding: 10px 14px 6px 8px; border-radius: 18px;
  background: var(--glass-hi); -webkit-backdrop-filter: blur(20px) saturate(1.6); backdrop-filter: blur(20px) saturate(1.6);
  border: 1px solid var(--glass-edge); box-shadow: var(--shadow-1), inset 0 0 0 1px var(--rule);
  animation: news-in .42s var(--ease-out) both;
}
@keyframes news-in { from { opacity: 0; transform: translateY(-6px); } }
.news-stage { grid-area: stage; position: relative; min-width: 0; display: grid; align-items: center; overflow: hidden; }
.news-item {
  grid-area: 1 / 1; min-width: 0; padding-block: 2px;
  opacity: 0; transform: translateY(70%); visibility: hidden;
  transition: transform .48s var(--ease-out), opacity .32s ease, visibility 0s .48s;
}
.news-item.is-on { opacity: 1; transform: none; visibility: visible; transition: transform .48s var(--ease-out), opacity .4s ease .06s, visibility 0s; }
.news-item.is-out { opacity: 0; transform: translateY(-70%); visibility: visible; }
.news-line { margin: 0; font: 500 16px/1.45 var(--f-body); color: var(--ink); text-wrap: pretty; }
.news-tag {
  display: inline-flex; align-items: center; gap: 4px; vertical-align: 1px; margin-inline-end: 8px;
  padding: 2px 8px 2px 9px; border-radius: 999px; font: 700 13px/1.3 var(--f-body); white-space: nowrap;
  background: var(--washi-2); color: var(--ink-2); box-shadow: inset 0 0 0 1px var(--rule);
}
.news-tag .icon { width: 15px; height: 15px; flex: none; }
.news-tag[data-kind="new"], .news-tag[data-kind="content"], .news-tag[data-kind="important"] { background: var(--seal); color: var(--on-seal); box-shadow: none; }
.news-line strong { font-weight: 800; }
.news-cta {
  display: inline-flex; align-items: center; gap: 3px; margin-inline-start: 6px; white-space: nowrap;
  font-weight: 700; color: var(--seal); text-decoration: none; border-radius: 6px;
}
.news-cta svg { width: 16px; height: 16px; transition: transform .16s var(--ease-out); }
.news-cta:hover { text-decoration: underline; text-underline-offset: 3px; }
@media (hover: hover) and (pointer: fine) { .news-cta:hover svg { transform: translateX(-3px); } }
.news-cta:active { transform: scale(.97); }
.news-chip {
  display: inline-grid; place-items: center; width: 1.2em; height: 1.32em; vertical-align: -0.28em; margin-inline: 2px 0;
  background: var(--piece-line); clip-path: polygon(50% 0, 86% 16%, 100% 100%, 0 100%, 14% 16%); position: relative;
}
.news-chip::before { content: ''; position: absolute; inset: 1.5px; background: var(--piece); clip-path: inherit; }
.news-chip b { position: relative; font: 800 0.78em/1 var(--f-piece); color: var(--piece-ink); padding-top: .3em; }
.nw { white-space: nowrap; }
.news-chess { font-family: var(--f-chess), var(--f-body); font-size: 1.1em; letter-spacing: 1px; color: var(--ink); }
.news-ctrl { grid-area: ctrl; display: flex; align-items: center; gap: 2px; }
.news-btn {
  display: grid; place-items: center; width: 36px; height: 36px; border: 0; border-radius: 10px; padding: 0;
  background: transparent; color: var(--muted); cursor: pointer; transition: background-color .16s ease, transform .16s var(--ease-out);
}
.news-btn svg { width: 18px; height: 18px; }
@media (hover: hover) and (pointer: fine) { .news-btn:hover { background: var(--washi-2); color: var(--ink); } }
.news-btn:active { transform: scale(.97); }
.news-btn:focus-visible, .news-cta:focus-visible, .news-seg:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
.news-btn .i-play { display: none; }
.news.is-paused .news-btn .i-play { display: block; }
.news.is-paused .news-btn .i-pause { display: none; }
.news-segs { grid-area: segs; display: flex; gap: 5px; min-width: 0; }
.news-seg { flex: 1; height: 12px; display: flex; align-items: center; border: 0; padding: 0; background: none; cursor: pointer; border-radius: 4px; }
.news-seg i { display: block; position: relative; width: 100%; height: 3px; border-radius: 3px; background: var(--rule); overflow: hidden; }
.news-seg i::after { content: ''; position: absolute; inset: 0; background: var(--seal); transform: scaleX(0); transform-origin: right; border-radius: inherit; }
.news-seg.is-done i::after { transform: scaleX(1); opacity: .55; }
.news-seg.is-on i::after { animation: news-fill var(--news-dwell, 5s) linear forwards; }
.news.is-paused .news-seg.is-on i::after { animation-play-state: paused; }
.news.is-still .news-seg.is-on i::after { animation: none; transform: scaleX(1); }
@keyframes news-fill { to { transform: scaleX(1); } }
.news.is-closing { overflow: hidden; transition: height .2s var(--ease-out), opacity .18s ease, margin .2s var(--ease-out); opacity: 0; }

@container news (max-width: 620px) {
  .news-card { grid-template-areas: "stage stage" "segs ctrl"; padding: 12px 14px 2px 6px; border-radius: 16px; gap: 2px 12px; }
  .news-line { font-size: 15px; line-height: 1.5; }
  .news-btn { width: 34px; height: 34px; }
}
@media (prefers-reduced-motion: reduce) {
  .news-card { animation: news-fade .2s ease both; }
  .news-item, .news-item.is-on, .news-item.is-out { transform: none; transition: opacity .2s ease, visibility 0s; }
  .news-seg.is-on i::after { animation: none; transform: scaleX(1); }
}
@keyframes news-fade { from { opacity: 0; } }
@media (prefers-reduced-transparency: reduce) { .news-card { -webkit-backdrop-filter: none; backdrop-filter: none; background: var(--surface); } }
:root.tour-on .news { display: none; }
.news:not([hidden]) + .hero, .news:not([hidden]) ~ .me { padding-top: 20px; }
.app > .news { margin-block: 0 18px; }
@media (min-width: 900px) { .news:not([hidden]) + .hero, .news:not([hidden]) ~ .me { padding-top: 36px; } }
</style>
