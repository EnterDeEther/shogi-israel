---
// Game against the computer: board, table and setup, driven by src/play/ (engines run in the browser).
// The page must be cross-origin isolated (COOP/COEP in vercel.json) for the engines' threads.
import '../styles/shogiground.css';
import '../styles/learn.css';
import '../styles/play.css';
---
<section class="play-island" data-play aria-label="משחק נגד המחשב">
  <noscript><p>המשחק נגד המחשב צריך JavaScript.</p></noscript>
</section>
<p class="small muted play-credit">
  המחשב רץ אצלכם בדפדפן, בלי שרת: ברמות 1 עד 4 המנוע <a href="https://github.com/fairy-stockfish/Fairy-Stockfish" rel="noopener">Fairy-Stockfish</a>,
  וברמות 5 עד 10 המנוע <a href="https://github.com/yaneurao/YaneuraOu" rel="noopener">YaneuraOu</a> עם פונקציית ההערכה SuishoPetite (שניהם ברישיון GPL-3.0).
  סולם הרמות זהה לזה של <a href="https://lishogi.org" rel="noopener">Lishogi</a>.{' '}
  <a href="https://github.com/EnterDeEther/shogi-israel/tree/main/src/play" rel="noopener">קוד המקור</a>
</p>

<script>
  import { bootPlay } from '../play/boot';
  document.querySelectorAll<HTMLElement>('[data-play]').forEach((el) => bootPlay(el));
</script>

<style>
  .play-credit { margin: 4px 0 0; max-width: 760px; line-height: 1.6; }
</style>
