---
import { accountsEnabled } from '../lib/account-config';
const path = Astro.url.pathname;
// Everything that teaches the game sits under one heading (Dean, 2026-10-24).
const learn = {
  label: 'למד לשחק',
  links: [
    { href: '/rules/', label: 'קורס החוקים' },
    { href: '/learn/', label: 'שיעורים אינטראקטיביים' },
  ],
};
const links = [
  { href: '/#community', label: 'קהילה' },
  { href: '/about/', label: 'אודות' },
];
const isCurrent = (href: string) => href !== '/#community' && path.startsWith(href);
const inLearn = learn.links.some((l) => isCurrent(l.href));
---
<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label="שוגי ישראל, לדף הבית">
      <img class="logo" src="/logo-96.png" width="44" height="44" alt="" />
      <span class="brand-name">שוגי ישראל</span>
    </a>
    <nav class="nav-wide" aria-label="ראשי">
      <details class="nav-group" data-nav-group>
        <summary class={inLearn ? 'current' : undefined}>{learn.label}<svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg></summary>
        <div class="nav-menu">
          {learn.links.map((l) => <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a>)}
        </div>
      </details>
      {links.map((l) => <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a>)}
      {accountsEnabled && <a class="account-link" href="/account/" data-account-link aria-current={isCurrent('/account/') ? 'page' : undefined}>כניסה</a>}
    </nav>
    <details class="nav-narrow">
      <summary aria-label="תפריט">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h10"></path></svg>
      </summary>
      <nav aria-label="ראשי (נייד)">
        <a href="/">בית</a>
        <span class="nav-heading">{learn.label}</span>
        {learn.links.map((l) => <a class="sub" href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a>)}
        {links.map((l) => <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a>)}
        {accountsEnabled && <a href="/account/" data-account-link aria-current={isCurrent('/account/') ? 'page' : undefined}>כניסה</a>}
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header { border-bottom: 1px solid var(--rule); background: var(--washi); position: relative; z-index: 20; }
  .bar { display: flex; align-items: center; justify-content: space-between; min-height: 64px; }
  .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; color: var(--ink); }
  .logo { width: 44px; height: 44px; flex-shrink: 0; }
  .brand-name { font-family: var(--f-display); font-weight: 900; font-size: 22px; letter-spacing: -0.2px; }
  .nav-wide { display: none; gap: 28px; }
  .nav-wide a { color: var(--ink); text-decoration: none; font-weight: 500; padding: 8px 0; border-bottom: 2px solid transparent; }
  .nav-wide a:hover, .nav-wide a[aria-current="page"] { border-bottom-color: var(--seal); color: var(--ink); }
  .nav-narrow summary {
    list-style: none; width: 44px; height: 44px; display: flex; align-items: center; justify-content: center;
    cursor: pointer; color: var(--ink); border-radius: 6px;
  }
  .nav-narrow summary::-webkit-details-marker { display: none; }
  .nav-narrow[open] summary { background: var(--washi-2); }
  .nav-narrow nav {
    position: absolute; inset-inline: 0; top: 100%; background: var(--washi);
    border-bottom: 1px solid var(--rule); padding: 8px var(--gutter) 16px; display: flex; flex-direction: column;
    box-shadow: 0 12px 20px -16px rgba(0, 0, 0, 0.4);
  }
  .nav-narrow nav a {
    min-height: 52px; display: flex; align-items: center; color: var(--ink); text-decoration: none;
    font-size: 18px; font-weight: 500; border-bottom: 1px solid var(--rule);
  }
  .nav-narrow nav a:last-child { border-bottom: 0; }
  .nav-narrow nav a[aria-current="page"] { color: var(--seal); font-weight: 700; }
  .nav-group { position: relative; }
  .nav-group summary {
    list-style: none; display: flex; align-items: center; gap: 6px; cursor: pointer;
    color: var(--ink); font-weight: 500; padding: 8px 0; border-bottom: 2px solid transparent;
  }
  .nav-group summary::-webkit-details-marker { display: none; }
  .nav-group summary:hover, .nav-group summary.current { border-bottom-color: var(--seal); }
  .nav-group[open] summary svg { transform: rotate(180deg); }
  .nav-menu {
    position: absolute; top: calc(100% + 8px); inset-inline-start: -14px; min-width: 220px; z-index: 30;
    display: flex; flex-direction: column; padding: 6px; background: var(--washi);
    border: 1.5px solid var(--ink); border-radius: 8px; box-shadow: 0 12px 24px -16px rgba(0, 0, 0, 0.5);
  }
  .nav-wide .nav-menu a { padding: 10px 12px; border-radius: 4px; border-bottom: 0; }
  .nav-wide .nav-menu a:hover, .nav-wide .nav-menu a[aria-current="page"] { background: var(--washi-2); }
  .nav-heading { min-height: 40px; display: flex; align-items: flex-end; font-size: 14px; font-weight: 700; color: var(--muted); }
  .nav-narrow nav a.sub { padding-inline-start: 14px; }
  .nav-wide a.account-link { border: 1.5px solid var(--ink); border-radius: 6px; padding: 6px 14px; }
  .nav-wide a.account-link:hover, .nav-wide a.account-link[aria-current="page"] { border-color: var(--seal); color: var(--seal); }
  @media (min-width: 768px) {
    .nav-wide { display: flex; align-items: center; }
    .nav-narrow { display: none; }
  }
</style>

<script>
  // Signed in: the header link reads "החשבון שלי" (the nickname itself lives on the account page).
  import { hasStoredSession } from '../lib/account-config';
  if (hasStoredSession()) document.querySelectorAll('[data-account-link]').forEach((a) => { a.textContent = 'החשבון שלי'; });

  // "למד לשחק" menu: close on Escape (focus back on the heading) and on a click elsewhere.
  document.querySelectorAll<HTMLDetailsElement>('[data-nav-group]').forEach((d) => {
    d.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && d.open) { d.open = false; d.querySelector('summary')?.focus(); }
    });
    document.addEventListener('click', (e) => { if (d.open && !d.contains(e.target as Node)) d.open = false; });
  });
</script>
