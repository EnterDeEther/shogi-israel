---
// The menu itself lives in src/lib/nav.ts; this file only draws it (desktop bar + phone panel).
import { ACCOUNT, isCurrent, isLive, isSection, liveNav, withChips, type NavLink } from '../lib/nav';
import { WEEK_LENGTH } from '../tsume/week';

const path = Astro.url.pathname;
const items = liveNav();
const account = isLive(ACCOUNT) ? ACCOUNT : undefined;
const here = (l: NavLink) => (isCurrent(l, path) ? 'page' : undefined);
const ext = (l: NavLink) => (l.external ? { rel: 'noopener', target: '_blank' } : {});
// the bell (signed-in only, src/lib/inbox-ui.ts) needs the size of the weekly-puzzle collection
const tsume = import.meta.glob<{ default: unknown[] }>('../tsume/data/mate*.json', { eager: true });
const weekCount = tsume[`../tsume/data/mate${WEEK_LENGTH}.json`]?.default.length ?? 0;
---
<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label="שוגי ישראל, לדף הבית">
      <img class="logo" src="/logo-96.png" width="44" height="44" alt="" />
      <span class="brand-name">שוגי ישראל</span>
    </a>

    <nav class="nav-wide" aria-label="ראשי">
      {items.map((i) => isSection(i) ? (
        <details class="nav-group" data-nav-group data-tour={i.tour}>
          <summary class={i.links.some((l) => isCurrent(l, path)) ? 'current' : undefined}>
            {i.label}
            <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>
          </summary>
          <div class="nav-menu">
            {i.links.map((l) => (
              <a href={l.href} class={l.sub ? 'sub' : undefined} aria-current={here(l)} {...ext(l)}>
                <span class="label">{l.label}{l.external && <span class="ext" aria-hidden="true">↗</span>}</span>
                {l.hint && <span class="hint">{l.hint}</span>}
              </a>
            ))}
          </div>
        </details>
      ) : (
        <a class="top" href={i.href} aria-current={here(i)} {...ext(i)}>{i.label}</a>
      ))}
      {account && <a class="account" data-tour="account" href={account.href} aria-current={here(account)}><span data-signed-in-only>{account.label}</span><span data-signed-out-only>הרשמה / כניסה</span></a>}
    </nav>

    {account && (
      <details class="inbox" data-inbox data-signed-in-only data-week-count={weekCount} data-tour="bell">
        <summary>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9a6 6 0 0 1 12 0c0 5 2 6.5 2 6.5H4S6 14 6 9z"></path><path d="M10 19a2 2 0 0 0 4 0"></path></svg>
          <span class="visually-hidden" data-inbox-label>התראות</span>
          <span class="inbox-count" data-inbox-count aria-hidden="true" hidden></span>
        </summary>
        <div class="inbox-panel" data-inbox-panel>
          <p class="inbox-title">התראות</p>
          <ul class="inbox-list" data-inbox-list aria-live="polite"></ul>
          <p class="inbox-foot"><a href="/account/#notifications">הגדרות התראות</a></p>
        </div>
      </details>
    )}

    <button type="button" class="theme-btn" data-theme-toggle aria-label="מעבר למצב כהה" aria-pressed="false">
      <svg class="i-moon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"></path></svg>
      <svg class="i-sun" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6"></path></svg>
    </button>

    <details class="nav-narrow" data-nav-narrow>
      <summary aria-label="תפריט">
        <svg class="i-open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h10"></path></svg>
        <svg class="i-close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
      </summary>
      <nav class="panel" aria-label="ראשי (נייד)">
        {items.map((i) => isSection(i) ? (
          <section class="group" data-tour={i.tour}>
            <h2 class="group-title">{i.label}</h2>
            <ul>
              {withChips(i.links).map((l) => Array.isArray(l) ? (
                <li class="chips">{l.map((c) => <a href={c.href} aria-current={here(c)}>{c.label}</a>)}</li>
              ) : (
                <li>
                  <a href={l.href} aria-current={here(l)} {...ext(l)}>
                    <span class="label">{l.label}{l.external && <span class="ext" aria-hidden="true">↗</span>}</span>
                    {l.hint && <span class="hint">{l.hint}</span>}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ) : (
          <a class="solo" href={i.href} aria-current={here(i)} {...ext(i)}>{i.label}</a>
        ))}
        {account && <a class="solo account" data-tour="account" href={account.href} aria-current={here(account)}><span data-signed-in-only>{account.label}</span><span data-signed-out-only>הרשמה / כניסה</span></a>}
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header { border-bottom: 1px solid var(--rule); background: var(--washi); position: relative; z-index: 20; }
  .bar { display: flex; align-items: center; min-height: 64px; gap: 16px; }
  .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; color: var(--ink); flex-shrink: 0; }
  .logo { width: 44px; height: 44px; flex-shrink: 0; }
  .brand-name { font-family: var(--f-display); font-weight: 900; font-size: 22px; letter-spacing: -0.2px; white-space: nowrap; }
  .ext { font-size: 0.8em; margin-inline-start: 4px; color: var(--muted); }
  .hint { display: block; font-size: 14px; font-weight: 400; color: var(--muted); line-height: 1.4; }

  /* Light / dark button: shows the sun in dark mode (press for light) and the moon in light mode. */
  .theme-btn {
    appearance: none; background: transparent; border: 0; color: var(--ink); cursor: pointer;
    width: 44px; height: 44px; border-radius: 6px; display: flex; align-items: center; justify-content: center;
    margin-inline-start: auto; flex-shrink: 0;
  }
  .theme-btn:hover { background: var(--washi-2); }
  .theme-btn .i-sun { display: none; }
  :global(html[data-theme="dark"]) .theme-btn .i-sun { display: block; }
  :global(html[data-theme="dark"]) .theme-btn .i-moon { display: none; }

  /* ---------- the bell (signed-in visitors): sits just before the light / dark button ---------- */
  .inbox { position: static; margin-inline-start: auto; flex-shrink: 0; }
  :global(html[data-signed-in]) .theme-btn { margin-inline-start: 0; }
  .inbox summary {
    list-style: none; position: relative; width: 44px; height: 44px; border-radius: 6px; cursor: pointer;
    display: flex; align-items: center; justify-content: center; color: var(--ink);
  }
  .inbox summary::-webkit-details-marker { display: none; }
  .inbox summary:hover, .inbox[open] summary { background: var(--washi-2); }
  .inbox-count {
    position: absolute; top: 4px; inset-inline-end: 2px; min-width: 18px; height: 18px; padding: 0 5px; border-radius: 9px;
    background: var(--seal); color: var(--on-seal); font: 700 11px/18px var(--f-body); text-align: center;
  }
  .inbox-panel {
    position: absolute; top: 100%; inset-inline: 0; z-index: 30; max-height: calc(100dvh - 64px); overflow-y: auto; overscroll-behavior: contain;
    background: var(--washi); border-top: 1px solid var(--rule); border-bottom: 1.5px solid var(--ink);
    padding: 12px var(--gutter) 14px; box-shadow: 0 12px 24px -16px rgba(0, 0, 0, 0.5);
  }
  .inbox-title { margin: 0 0 6px; font-size: 13px; font-weight: 700; letter-spacing: 0.4px; color: var(--seal); }
  .inbox-list { list-style: none; margin: 0; padding: 0; }
  .inbox-list :global(.inbox-item) { display: flex; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--rule); align-items: flex-start; }
  .inbox-list :global(.inbox-item p) { margin: 0 0 2px; line-height: 1.5; }
  .inbox-list :global(.inbox-item a) { color: var(--seal); font-weight: 700; }
  .inbox-list :global(.inbox-sub) { color: var(--muted); font-size: 14px; }
  .inbox-list :global(.inbox-kanji) {
    flex: none; display: grid; place-items: center; min-width: 36px; height: 36px; padding: 0 4px; border-radius: 18px;
    background: var(--washi-2); border: 1px solid var(--rule); color: var(--ink); font: 700 15px/1 var(--f-kanji);
  }
  .inbox-list :global(.inbox-item.new .inbox-kanji) { background: var(--seal); border-color: var(--seal); color: var(--on-seal); }
  .inbox-list :global(.inbox-item.new p) { font-weight: 700; }
  .inbox-list :global(.inbox-empty) { padding: 14px 0; color: var(--muted); }
  .inbox-foot { margin: 10px 0 0; font-size: 15px; }
  .inbox-foot a { color: var(--ink-2); }

  /* ---------- phones: a full-height panel under the bar ---------- */
  .nav-wide { display: none; }
  .nav-narrow summary {
    list-style: none; width: 44px; height: 44px; display: flex; align-items: center; justify-content: center;
    cursor: pointer; color: var(--ink); border-radius: 6px; margin-inline-end: -10px;
  }
  .nav-narrow summary::-webkit-details-marker { display: none; }
  .nav-narrow .i-close, .nav-narrow[open] .i-open { display: none; }
  .nav-narrow[open] .i-close { display: block; }
  .panel {
    position: absolute; inset-inline: 0; top: 100%; height: calc(100dvh - 64px); overflow-y: auto; overscroll-behavior: contain;
    background: var(--washi); border-top: 1px solid var(--rule);
    padding: 8px var(--gutter) 32px; display: flex; flex-direction: column;
  }
  .group { padding: 16px 0 8px; border-bottom: 1px solid var(--rule); }
  .group-title {
    margin: 0 0 4px; font-family: inherit; font-size: 13px; font-weight: 700; letter-spacing: 0.4px; color: var(--seal);
  }
  .group ul { list-style: none; margin: 0; padding: 0; }
  .group a, .panel .solo {
    display: flex; flex-direction: column; justify-content: center; min-height: 48px; padding: 6px 0;
    color: var(--ink); text-decoration: none; font-size: 18px; font-weight: 500; line-height: 1.35;
  }
  .group .chips { display: flex; flex-wrap: wrap; gap: 8px; padding: 2px 0 10px; }
  .group .chips a {
    min-height: 40px; padding: 0 14px; font-size: 16px; border: 1px solid var(--rule); border-radius: 999px; background: var(--washi-2);
  }
  .panel .solo { min-height: 60px; font-weight: 700; border-bottom: 1px solid var(--rule); }
  .panel .solo.account { margin-top: 20px; min-height: 48px; justify-content: center; align-items: center; border: 1.5px solid var(--ink); border-radius: 8px; }
  .panel a[aria-current="page"] { color: var(--seal); font-weight: 700; }
  .panel a[aria-current="page"] .label::before { content: '● '; font-size: 0.6em; vertical-align: middle; }

  /* ---------- desktop: a bar with dropdowns ---------- */
  @media (min-width: 1040px) {
    .nav-narrow { display: none; }
    .nav-wide { display: flex; align-items: center; gap: 22px; margin-inline-start: auto; }
    .theme-btn { margin-inline-start: 0; }
    .inbox { position: relative; margin-inline-start: 0; }
    .inbox-panel {
      top: calc(100% + 8px); inset-inline: auto -8px; width: 380px; max-height: 70vh; padding: 10px 16px 12px;
      border: 1.5px solid var(--ink); border-radius: 8px;
    }
  }
  .nav-wide .top, .nav-group summary {
    color: var(--ink); text-decoration: none; font-weight: 500; padding: 8px 0; border-bottom: 2px solid transparent; white-space: nowrap;
  }
  .nav-wide .top:hover, .nav-wide .top[aria-current="page"] { border-bottom-color: var(--seal); }
  .nav-group { position: relative; }
  .nav-group summary { list-style: none; display: flex; align-items: center; gap: 6px; cursor: pointer; }
  .nav-group summary::-webkit-details-marker { display: none; }
  .nav-group summary:hover, .nav-group summary.current { border-bottom-color: var(--seal); }
  .nav-group[open] summary svg { transform: rotate(180deg); }
  .nav-menu {
    position: absolute; top: calc(100% + 8px); inset-inline-start: -14px; min-width: 250px; z-index: 30;
    display: flex; flex-direction: column; padding: 6px; background: var(--washi);
    border: 1.5px solid var(--ink); border-radius: 8px; box-shadow: 0 12px 24px -16px rgba(0, 0, 0, 0.5);
  }
  .nav-menu a { padding: 9px 12px; border-radius: 4px; color: var(--ink); text-decoration: none; font-weight: 500; }
  .nav-menu a.sub { padding-block: 7px; padding-inline-start: 26px; font-size: 15px; }
  .nav-menu a:hover, .nav-menu a[aria-current="page"] { background: var(--washi-2); }
  .nav-menu a[aria-current="page"] .label { color: var(--seal); }
  .nav-wide .account {
    color: var(--ink); text-decoration: none; font-weight: 700; padding: 7px 14px; border: 1.5px solid var(--ink); border-radius: 6px; white-space: nowrap;
  }
  .nav-wide .account:hover, .nav-wide .account[aria-current="page"] { background: var(--washi-2); }
</style>

<script>
  // Desktop dropdowns: one open at a time; close on Escape (focus back on the heading) and on a click elsewhere.
  const groups = document.querySelectorAll<HTMLDetailsElement>('[data-nav-group]');
  groups.forEach((d) => {
    d.addEventListener('toggle', () => { if (d.open) groups.forEach((o) => { if (o !== d) o.open = false; }); });
    d.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && d.open) { d.open = false; d.querySelector('summary')?.focus(); }
    });
  });
  document.addEventListener('click', (e) => {
    groups.forEach((d) => { if (d.open && !d.contains(e.target as Node)) d.open = false; });
  });

  // Phone panel: the page behind does not scroll while it is open; Escape or a link closes it
  // (a link to a #section on this same page would otherwise leave the panel covering it).
  const narrow = document.querySelector<HTMLDetailsElement>('[data-nav-narrow]');
  if (narrow) {
    narrow.addEventListener('toggle', () => { document.documentElement.style.overflow = narrow.open ? 'hidden' : ''; });
    narrow.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && narrow.open) { narrow.open = false; narrow.querySelector('summary')?.focus(); }
    });
    narrow.querySelectorAll('.panel a').forEach((a) => a.addEventListener('click', () => { narrow.open = false; }));
  }
</script>
