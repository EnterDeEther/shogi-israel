---
import { HOME_FAQ } from '../lib/home-story';
import { FAQ } from '../lib/shogi-faq';
import { TOUR_URL } from '../lib/tour';

const faq = HOME_FAQ.map((id) => FAQ.find((f) => f.id === id)).filter((f) => !!f);
---
<section class="scene wrap home-faq" id="faq" data-newcomer aria-labelledby="story-faq-h">
  <div class="scene-head rv"><h2 id="story-faq-h">שאלות נפוצות</h2></div>
  <div class="faq">
    {faq.map((f) => (
      <details>
        <summary>{f.q}</summary>
        <p set:html={f.a} />
      </details>
    ))}
  </div>
  <div class="endrow">
    <a href="/what-is-shogi/">לכל השאלות ←</a>
    <a class="btn btn-ghost tour-go" href={TOUR_URL} data-tour-start data-nudge>
      <span>מה יש באתר? סיור קצר</span>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"></path></svg>
    </a>
  </div>
</section>

<script>
  const go = document.querySelector<HTMLElement>('.home-faq [data-nudge]');
  if (go && 'IntersectionObserver' in window) new IntersectionObserver(([en]) => go.classList.toggle('nudging', en.isIntersecting), { threshold: 0.6 }).observe(go);
</script>

<style>
  .scene { margin-top: 56px; scroll-snap-align: start; }
  .scene-head { display: grid; gap: 6px; margin-bottom: 8px; }
  .scene-head h2 { font-size: clamp(30px, 7vw, 44px); }
  .faq { display: grid; border-top: 1px solid var(--rule); margin-top: 12px; max-width: 760px; }
  .faq details { border-bottom: 1px solid var(--rule); }
  .faq summary { cursor: pointer; list-style: none; display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 56px; font-weight: 700; font-size: 18px; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: "+"; flex: none; font: 400 26px/1 var(--f-body); color: var(--seal); transition: rotate .22s var(--ease-out); }
  .faq details[open] summary::after { rotate: 45deg; }
  .faq details p { margin: 0; padding-bottom: 16px; color: var(--ink-2); line-height: 1.65; }
  .faq details::details-content { display: grid; grid-template-rows: 0fr; opacity: 0; transition: grid-template-rows .22s var(--ease-out), opacity .22s var(--ease-out), content-visibility .22s allow-discrete; }
  .faq details[open]::details-content { grid-template-rows: 1fr; opacity: 1; }
  .faq details > p { min-height: 0; overflow: visible clip; transition: padding-bottom .22s var(--ease-out); }
  .faq details:not([open]) > p { padding-bottom: 0; }
  @media (prefers-reduced-motion: reduce) {
    .faq summary::after, .faq details > p { transition: none; }
    .faq details::details-content { transition: opacity .2s ease, content-visibility .2s allow-discrete; }
  }
  @media (max-width: 899px) and (orientation: landscape) and (max-height: 520px) { .faq { padding-inline-end: 58px; } }
  .endrow { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; margin-top: 18px; }
  .endrow > a:first-child { display: inline-flex; align-items: center; min-height: 48px; padding-inline-end: 12px; font-weight: 700; }
  @media (max-width: 599px) { .tour-go { align-self: stretch; max-width: 420px; } }
  @media (prefers-reduced-motion: no-preference) {
    .tour-go.nudging svg { animation: tour-nudge 4.8s var(--ease-out) .6s infinite; }
    :global(html.tour-on) .tour-go svg { animation: none; }
  }
  @keyframes tour-nudge { 0%, 16%, 100% { translate: 0 0; } 7% { translate: -6px 0; } }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .rv { animation: rise linear both; animation-timeline: view(); animation-range: entry 0% entry 55%; }
    }
  }
  @keyframes rise { from { opacity: 0; translate: 0 28px; } to { opacity: 1; translate: 0 0; } }
</style>
