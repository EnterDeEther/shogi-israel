---
// Letters / kanji switch. Every instance drives one site-wide setting (html[data-pieces]),
// remembered on this device only. Logic lives in Base.astro so there is one listener.
---
<div class="seg" role="group" aria-label="סימון הכלים">
  <button type="button" data-pieces-set="letters" aria-pressed="true">אותיות</button>
  <button type="button" data-pieces-set="kanji" aria-pressed="false">קאנג׳י</button>
</div>
